+{
+    static x0x_param_t d;
+    if (field < 0 || field >= CK_NE)
+        return 0;
+    d.name = ck_nm(CK_FLD_N, (uint32_t)field);
+    d.max = CK_FMAX[field];
+    d.names = 0;
+    return &d;
+}
+
+static int smk_ck_field_get(int field) { return (int)ck_get((uint32_t)field); }
+static void smk_ck_field_set(int field, int value) { ck_set((uint32_t)field, (uint32_t)value); }
+static int smk_ck_smc_page(void) { return clip_grid_mode && ck_page_on(); }
+
+static pref_t smk_ck_smc_ref(int n)
+{
+    uint32_t page = (ck.pg & 3u) - 1u;
+    if (!smk_ck_smc_page() || n < 0 || n >= (page == 2u ? 8 : 4))
+        return NONE;
+    return PR(R_CKFIELD, CK_PAGE_FIELDS[page][n], page, 0);
+}
