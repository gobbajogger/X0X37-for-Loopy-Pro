index dd669ee..b941d06 100644
--- a/tools/gen_drum_samples.py
+++ b/tools/gen_drum_samples.py
@@ -137,13 +137,15 @@ def main():
         hdr.append("")
     out_s.write_text("\n".join(hdr))
 
-    tab = [f32(math.tanh(TANH_MAX * i / TANH_N)) for i in range(TANH_N + 2)]
+    # 16-bit fixed point (0..65535 for tanh 0..1): half the flash of float, abs error <= 7.7e-6
+    tab = [round(math.tanh(TANH_MAX * i / TANH_N) * 65535.0) for i in range(TANH_N + 2)]
     t = ["/* Generated by tools/gen_drum_samples.py -- do not edit. */",
-         "#pragma once", "",
-         f"/* tanh(u) at u = i * {TANH_MAX} / {TANH_N}, i = 0..{TANH_N + 1} (one guard point) */",
+         "#pragma once", "#include <stdint.h>", "",
+         f"/* tanh(u) at u = i * {TANH_MAX} / {TANH_N}, i = 0..{TANH_N + 1} (one guard point), x 65535 */",
          f"#define X0X_TANH_N {TANH_N}",
          f"#define X0X_TANH_SCALE {cfloat(TANH_N / TANH_MAX)}",
-         arr("float", "x0x_tanh_tab", tab, cfloat, per=6, shared=True), "",
+         "#define X0X_TANH_Q (1.0f / 65535.0f)",
+         arr("uint16_t", "x0x_tanh_tab", tab, per=12, shared=True), "",
          "/* 9W9 EXP pots (er99_pots.h): value = min * (max/min)^(pot/127), pot 0..127 */"]
     for i, (n, lo, hi) in enumerate(EXP_RANGES):
