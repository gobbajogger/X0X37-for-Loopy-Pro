From 8b6d9322387351000cb541889b43d04c7dc39b13 Mon Sep 17 00:00:00 2001
From: genkigenki <3080081+genkigenki@users.noreply.github.com>
Date: Fri, 16 Oct 2026 18:25:43 +1000
Subject: [PATCH 31/36] 909 tanh table: 16-bit fixed point. Free 2 KB of flash.

The tanh table is uint16 (x 65535), not float. The table error is 7.7e-6 or less.
drum909 and drum808 host tests pass against 9W9 and 8W8. The worst case does not change.
The median error of drum909 goes from 9.1e-5 to 9.6e-5 (relative).
App code area: 10064 B free.
---
 firmware/src/dsp/drum909_dsp.h |  3 ++-
 tools/gen_drum_samples.py      | 10 ++++++----
 2 files changed, 8 insertions(+), 5 deletions(-)

diff --git a/firmware/src/dsp/drum909_dsp.h b/firmware/src/dsp/drum909_dsp.h
index c64b2d3..1e79765 100644
--- a/firmware/src/dsp/drum909_dsp.h
+++ b/firmware/src/dsp/drum909_dsp.h
@@ -197,7 +197,8 @@ static inline float d9_tanh(float u)
     } else {
         const int32_t i = (int32_t)a;
         const float fr = a - (float)i;
-        t = x0x_tanh_tab[i] + (x0x_tanh_tab[i + 1] - x0x_tanh_tab[i]) * fr;
+        const float t0 = (float)x0x_tanh_tab[i];
+        t = (t0 + ((float)x0x_tanh_tab[i + 1] - t0) * fr) * X0X_TANH_Q;   /* (a 16-bit table) */
     }
     return u < 0.0f ? -t : t;
 }
