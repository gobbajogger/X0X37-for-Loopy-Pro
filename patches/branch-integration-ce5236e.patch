@@ -437,14 +437,13 @@ uint8_t smk_clip_lcd_draw(uint32_t w, uint32_t h)
     sig = (sig ^ ((uint32_t)apc_cols | (uint32_t)apc_rows << 8 | (uint32_t)apc_origin_col << 16 |
