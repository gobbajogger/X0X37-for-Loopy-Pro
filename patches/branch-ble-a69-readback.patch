+/* n bytes packed 7 to 8: a byte of high bits, then up to 7 low 7-bit bytes (ED_SMP_READ, ED_CTL_READ) */
+static void ed_put7(const uint8_t *src, uint32_t n)
+{
+    uint32_t k, j;
+    for (k = 0; k < n; k += 7) {
+        uint32_t m = 0;
+        for (j = 0; j < 7u && k + j < n; j++)
+            m |= (uint32_t)(src[k + j] >> 7) << j;
+        ed_b(m);
+        for (j = 0; j < 7u && k + j < n; j++)
+            ed_b(src[k + j]);
+    }
+}
