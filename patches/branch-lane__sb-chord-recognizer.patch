+                      "%.0f BPM in %.2f ms events (phase %u): measured %.2f", BPM[b], EV[e], ph, (double)S.ext_bpm);
+                run(44100);                                   /* the link ends: no tick for 1 s */
+                CHECK(S.ext == 0 && S.bpm == (float)BPM[b], "after the link end: internal %.1f, want %.0f",
+                      (double)S.bpm, BPM[b]);
