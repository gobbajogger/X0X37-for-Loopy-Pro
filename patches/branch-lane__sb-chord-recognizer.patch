+
+static void test_start_ext_running(void)
+{
+    int s, n, stop_at, run_no;
+    ui.part = PART_909;
+    set_view(V_PART);
+    build_pages();
+    clear_909();
+    tick(1500);
+    btn(B_REC, 1);
+    btn(B_REC, 0);
+    CHECK(ui.rec && !seq.playing, "REC on, stopped");
+    clk_on = 1;                                       /* 120 BPM, 7.5 ms connection events */
+    clk_tick_ms = 60000.0 / 120.0 / 24.0;
+    clk_ev_ms = 7.5;
