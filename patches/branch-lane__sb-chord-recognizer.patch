+            tail -15 "$OUT/$name.log" | sed 's/^/       /'
+            FAIL=1
+        fi
+        return
+    fi
+    key=$(printf '%04d' "$T_SEQ")
+    cls=$(test_class "$name")
+    case "$PHASE$cls" in WW|1P|1G|2S|3C) ;; *) return ;; esac
+    if [ "$cls" = S ] || [ "$cls" = C ]; then
