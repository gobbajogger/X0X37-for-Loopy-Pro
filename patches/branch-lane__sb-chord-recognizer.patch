+export X0X_TEST_TIME_SCALE=$SCALE
+PREPUSH=${X0X_PREPUSH_HOOK:-/workspace/x0x37.git/hooks/pre-push}
+GLOCK=${X0X_GATE_LOCK:-/workspace/x0x37-refs/gate.lock}
