+        check("K10 knob 7 turned under a stage: no CC 53 then or after the stage goes off", k == 0u);
+        knob_edit("K10 no stage: knob 2 sends CC 48", 0u, 1, &proj.set.ck_root, proj.set.ck_root, 1);
