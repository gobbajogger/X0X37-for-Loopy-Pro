+    host = 1u;
+    fake_intrusb = 0x04u;
+    run_bt(100);
+    plug();
+    usb_note(9u, 0x0Bu);
+    run_bt(500);
+    bt_up = bt_notify = 0u;
+    run_bt(1000);
+    check(apc_led_velocity[0] == 0u && apc_led_velocity[9] == 0x0Bu && lit_in(8u, 1u) == 0u && lit_in(10u, 2u) == 0u,
