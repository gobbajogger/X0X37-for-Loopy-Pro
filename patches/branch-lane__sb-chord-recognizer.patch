diff --git a/firmware/src/app/smc_protocol.h b/firmware/src/app/smc_protocol.h
new file mode 100644
index 0000000..03a6422
--- /dev/null
+++ b/firmware/src/app/smc_protocol.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#pragma once
+#include <stdint.h>
+
+/* Stock User preset MMC commands: 32 strip keys in M/S/R/SELECT order, then
+ * eleven global keys. The DAW note values are the same button identifiers. */
+static inline uint8_t smc_mmc_note(uint8_t cmd)
+{
+    static const uint8_t base[4] = {0x10, 0x08, 0x00, 0x18};
+    static const uint8_t tail[11] = {0x5E, 0x5D, 0x5F, 0x5B, 0x5C, 0x2E, 0x2F,
+                                      0x60, 0x61, 0x62, 0x63};
+    if (cmd >= 1u && cmd <= 32u)
+        return (uint8_t)(base[(cmd - 1u) & 3u] + ((cmd - 1u) >> 2));
+    return cmd >= 33u && cmd <= 43u ? tail[cmd - 33u] : 0xFFu;
+}
+
+static inline int smc_pickup_reached(uint8_t prior, int seen, uint8_t target, uint8_t current)
+{
+    if (seen && ((prior < target) != (current < target)))
+        return 1;
+    return current + 2u >= target && current <= target + 2u;
+}
+
+static inline int smc_relative(uint8_t value)
+{
+    return (value & 0x40u) ? -(int)(value & 0x3Fu) : (int)(value & 0x3Fu);
+}
+
+/* Host USB/peripheral BLE has no controller identity: opt-in User mode and
+ * channel 16 isolate these messages from instruments and APC40 feedback. */
+static inline int smc_host_accept(uint8_t status, uint8_t data1, int user_mode)
+{
+    uint8_t type = status & 0xF0u, a = data1 & 0x7Fu;
+    if (!user_mode || (status & 15u) != 15u)
+        return 0;
+    if (type == 0xB0u)
+        return (a >= 16u && a < 24u) || (a >= 40u && a < 48u);
+    if (type != 0x90u && type != 0x80u)
+        return 0;
+    return a < 32u || a == 0x2Eu || a == 0x2Fu || a == 0x30u || a == 0x31u ||
+           (a >= 0x5Bu && a <= 0x5Fu) || (a >= 0x60u && a <= 0x63u);
+}
diff --git a/tests/host/smc_protocol_test.c b/tests/host/smc_protocol_test.c
new file mode 100644
index 0000000..76674b9
--- /dev/null
+++ b/tests/host/smc_protocol_test.c
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include "../../firmware/src/app/smc_protocol.h"
+
+int main(void)
+{
+    static const uint8_t global[11] = {0x5E, 0x5D, 0x5F, 0x5B, 0x5C, 0x2E, 0x2F,
+                                       0x60, 0x61, 0x62, 0x63};
+    int strip, row, i;
+    const uint8_t base[4] = {0x10, 0x08, 0x00, 0x18};
+    for (strip = 0; strip < 8; strip++)
+        for (row = 0; row < 4; row++)
+            assert(smc_mmc_note((uint8_t)(strip * 4 + row + 1)) == base[row] + strip);
+    for (i = 0; i < 11; i++)
+        assert(smc_mmc_note((uint8_t)(33 + i)) == global[i]);
+    assert(smc_mmc_note(0) == 0xFF && smc_mmc_note(44) == 0xFF);
+
+    /* A new fader must first reach its current target, or cross it. A target
+     * change later makes the same physical position unpicked again. */
+    assert(!smc_pickup_reached(0, 0, 90, 20));
+    assert(!smc_pickup_reached(20, 1, 90, 87));
+    assert(smc_pickup_reached(87, 1, 90, 88));
+    assert(smc_pickup_reached(88, 1, 90, 94));
+    assert(!smc_pickup_reached(94, 0, 40, 92));
+    assert(smc_pickup_reached(92, 1, 40, 35));
+    assert(smc_relative(1) == 1 && smc_relative(0x41) == -1);
+    assert(smc_relative(0x3F) == 63 && smc_relative(0x7F) == -63);
+    assert(smc_relative(0x40) == 0);
+
+    /* Channel 16 opt-in keeps normal music and APC40 traffic out. */
+    assert(!smc_host_accept(0x9Fu, 16, 0));
+    assert(!smc_host_accept(0x90u, 16, 1));
+    assert(!smc_host_accept(0xBFu, 7, 1));
+    assert(!smc_host_accept(0x9Fu, 60, 1));
+    assert(smc_host_accept(0xBFu, 40, 1));
+    assert(smc_host_accept(0xBFu, 23, 1));
+    assert(smc_host_accept(0x9Fu, 16, 1));
+    assert(smc_host_accept(0x8Fu, 8, 1));
+    puts("SMC protocol: 43 buttons, pickup, encoders and host isolation ok");
+    return 0;
+}
