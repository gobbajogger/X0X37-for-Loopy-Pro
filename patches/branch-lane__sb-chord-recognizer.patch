+TOP="$(cd "$(dirname "$0")/../.." && pwd)"; CK="$TOP/tools/release_tree_check.sh"; F="$TOP/tests/host/fixtures/release_tree/paths.txt"
+T=$(mktemp -d "${TMPDIR:-/tmp}/reltree.XXXXXX"); trap 'rm -rf "$T"' EXIT
+fails=0; n=0
