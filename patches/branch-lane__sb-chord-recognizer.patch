+static void clear_909(void)
+{
+    memset(proj.pat[seq.ppat[0]].drum[0].hit, 0, sizeof proj.pat[0].drum[0].hit);
+    memset(proj.pat[seq.ppat[0]].drum[0].accent, 0, sizeof proj.pat[0].drum[0].accent);
