+    low = in->bass % 12u;
+    if (!(in->pcs >> low & 1u))
+        return 0;
+    all = ck_cd_fit(in->pcs, low, &r, &t);
+    iv = (low + 12u - r) % 12u;
+    core = CK_CD_CORE[t];
