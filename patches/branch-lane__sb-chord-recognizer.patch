From 4905072d60cd5630837eff63da909fba8009c202 Mon Sep 17 00:00:00 2001
From: genkigenki <3080081+genkigenki@users.noreply.github.com>
Date: Sat, 17 Oct 2026 01:14:28 +1000
Subject: [PATCH 144/240] prepush-check: do not run the quick check twice on
 the box

A push to integration of the box repository ran the quick check
two times: in the pre-push hook and in the server update hook.

Now prepush-check.sh can skip its run and give the line "quick check:
server runs it". These three conditions must be true:
- The push goes to the box repository.
- That repository has hooks/pre-receive and hooks/update.
- The sha256 of hooks/update is the sha256 of tools/update.hook of the
  pushed commit or of the remote tip.
All other pushes run the check as before. X0X_QC_CLIENT=1 always runs it.

Add test_prepush_trim.sh for the skip case and the run cases.
---
 tests/host/test_prepush_trim.sh | 47 +++++++++++++++++++++++++++++++++
 tests/run_tests.sh              |  1 +
 tools/prepush-check.sh          | 22 +++++++++++++++
 3 files changed, 70 insertions(+)
 create mode 100755 tests/host/test_prepush_trim.sh

diff --git a/tests/host/test_prepush_trim.sh b/tests/host/test_prepush_trim.sh
new file mode 100755
index 0000000..f9e4fb1
--- /dev/null
+++ b/tests/host/test_prepush_trim.sh
@@ -0,0 +1,47 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-only
+# tools/prepush-check.sh with a stub quickcheck.sh: a push to integration of the box repository with the same
+# update hook as tools/update.hook does not run the check here ("quick check: server runs it"). All other cases run it.
+set -u
+unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX GIT_QUARANTINE_PATH GIT_NAMESPACE
+unset X0X_QC_CLIENT X0X_BOX_REPO   # the test sets them per case
+D="$(cd "$(dirname "$0")/../.." && pwd)"
+T=$(mktemp -d "${TMPDIR:-/tmp}/ppt.XXXXXX"); trap 'rm -rf "$T"' EXIT
+mkdir -p "$T/g" && cp "$D/tools/prepush-check.sh" "$T/g/" && chmod 755 "$T/g/prepush-check.sh"
+printf '#!/bin/sh\necho run >> "%s/qc.calls"\necho "QUICK PASS stub"\n' "$T" > "$T/g/quickcheck.sh"; chmod 755 "$T/g/quickcheck.sh"
+G="git -c user.name=t -c user.email=t@t -c init.defaultBranch=main"
+$G init -q "$T/c" && mkdir -p "$T/c/tools" && echo 'echo hook v1' > "$T/c/tools/update.hook" && echo a > "$T/c/a" && \
+    $G -C "$T/c" add -A && $G -C "$T/c" commit -qm one || { echo "FAIL setup"; exit 1; }
+S=$(git -C "$T/c" rev-parse HEAD); Z=0000000000000000000000000000000000000000
+git init -q --bare "$T/box.git" && git init -q --bare "$T/other.git"
+hooks() {  # update-content|none pre-receive(1/0)
+    rm -f "$T/box.git/hooks/update" "$T/box.git/hooks/pre-receive"
+    [ "$1" = none ] || { printf '%s\n' "$1" > "$T/box.git/hooks/update"; chmod 755 "$T/box.git/hooks/update"; }
+    [ "$2" = 1 ] && { echo 'exit 0' > "$T/box.git/hooks/pre-receive"; chmod 755 "$T/box.git/hooks/pre-receive"; }; :; }
+fails=0
+chk() {  # name expect(skip|run|none) url [ref] [env...]
+    n=$1; e=$2; u=$3; r=${4:-refs/heads/integration}; if [ $# -ge 4 ]; then shift 4; else shift $#; fi
+    rm -f "$T/qc.calls"
+    out=$(cd "$T/c" && echo "refs/heads/main $S $r $Z" | env GIT_DIR="$T/c/.git" GIT_WORK_TREE="$T/c" X0X_BOX_REPO="$T/box.git" "$@" \
+        bash "$T/g/prepush-check.sh" origin "$u" 2>&1); rc=$?
+    got=none; [ -f "$T/qc.calls" ] && got=run
+    echo "$out" | grep -q 'quick check: server runs it' && got=skip
+    [ "$got" = skip ] && ! echo "$out" | grep -q "QUICK PASS ${S%"${S#???????}"}" && got=skip-no-pass
+    if [ "$got" = "$e" ] && [ $rc = 0 ]; then echo "ok   $n: $got"; else echo "FAIL $n: want $e, got $got (rc=$rc): $out"; fails=$((fails + 1)); fi
+}
+hooks 'echo hook v1' 1
+chk "box, same update hook"            skip "$T/box.git"
+chk "box as file:// URL"               skip "file://$T/box.git"
+chk "box, X0X_QC_CLIENT=1"             run  "$T/box.git" refs/heads/integration X0X_QC_CLIENT=1
+chk "other repository"                 run  "$T/other.git"
+chk "box, not integration"             none "$T/box.git" refs/heads/lane/x
+hooks 'echo hook v2' 1
+chk "box, other update hook sha"       run  "$T/box.git"
+hooks none 1
+chk "box, no update hook"              run  "$T/box.git"
+hooks 'echo hook v1' 0
+chk "box, no pre-receive hook"         run  "$T/box.git"
+hooks 'echo hook v1' 1; chmod 644 "$T/box.git/hooks/update"
+chk "box, update hook not executable"  run  "$T/box.git"
+echo "prepush trim: $fails FAIL"
+[ "$fails" = 0 ]
diff --git a/tests/run_tests.sh b/tests/run_tests.sh
index d582224..28da900 100755
--- a/tests/run_tests.sh
+++ b/tests/run_tests.sh
@@ -148,6 +148,7 @@ for t in drum909 drum808 bass303 breaks; do
     [ -f "tests/host/run_$t.sh" ] && run "$t" sh "tests/host/run_$t.sh"
 done
 run install-gate-guard sh tests/host/test_install_gate_guard.sh   # tools/require_gate_pass.sh: the install needs the gate PASS of the exact tree
+run prepush-trim sh tests/host/test_prepush_trim.sh   # tools/prepush-check.sh: the box update hook runs the quick check, so the client does not
 run gate-configs sh tests/host/test_gate_configs.sh   # tools/gate.sh: the dev and rel configs, the caller build variables removed
 run quickcheck-ste sh tests/host/test_quickcheck_ste.sh   # tools/quickcheck.sh: the STE step (warn, strict, clean) on a temp repository
 run loop-bars sh tests/host/run_loop_bars.sh            # engine.c loop_bars: the bar guess uses the loop's rate
diff --git a/tools/prepush-check.sh b/tools/prepush-check.sh
index be0c8d1..0482408 100755
--- a/tools/prepush-check.sh
+++ b/tools/prepush-check.sh
@@ -6,18 +6,40 @@
 # in a worktree of the pushing repository (<git common dir>/x0x37-quickcheck/wt, kept for incremental builds).
 # The changed files are the remote integration tip to the pushed commit. A tree with tools/ste_strict needs an
 # installed quickcheck.sh with the STE step (install_gate.sh also installs ste_check.py), else the push stops. A "QUICK FAIL" stops the push (exit code 1).
+# Trim: a push to integration of the box repository (X0X_BOX_REPO [/workspace/x0x37.git]) does not run the check
+# here when that repository has an executable hooks/pre-receive and hooks/update, and the sha256 of hooks/update is
+# the same as tools/update.hook of the pushed commit or of the remote integration tip. The update hook then runs the
+# same quick check (and stops the push on a fail). The script writes "QUICK PASS <sha> deferred, quick check: server
+# runs it" for the pre-push hook. All other pushes run the check here (fail closed). X0X_QC_CLIENT=1: always run here.
 set -u
 QC="$(cd "$(dirname "$0")" && pwd)/quickcheck.sh"
 Z=0000000000000000000000000000000000000000
 GC=$(git rev-parse --path-format=absolute --git-common-dir) || exit 0
 unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX GIT_QUARANTINE_PATH GIT_NAMESPACE   # the hook sets these; a scratch repository must not use the repository of the hook
 export GIT_DIR="$GC"   # only for the git calls of this script; quickcheck.sh clears it
+URL=${2:-}
+rpath() { p=${1#file://}; [ -n "$p" ] && [ -d "$p" ] && (cd "$p" && pwd -P); }
+server_runs_qc() {      # pushed-sha remote-sha: 0 when the update hook of the box repository runs the same quick check
+    [ "${X0X_QC_CLIENT:-0}" = 1 ] && return 1
+    u=$(rpath "$URL") || return 1; b=$(rpath "${X0X_BOX_REPO:-/workspace/x0x37.git}") || return 1
+    [ "$u" = "$b" ] && [ -x "$b/hooks/update" ] && [ -f "$b/hooks/update" ] && [ -x "$b/hooks/pre-receive" ] || return 1
+    SH=$(sha256sum < "$b/hooks/update" | cut -d' ' -f1)
+    for c in "$1" "$2"; do
+        [ "$c" != "$Z" ] && git cat-file -e "$c:tools/update.hook" 2>/dev/null || continue
+        [ "$(git cat-file blob "$c:tools/update.hook" | sha256sum | cut -d' ' -f1)" = "$SH" ] && SC=$c && return 0
+    done
+    return 1
+}
 
 rc=0
 while read -r lref lsha rref rsha; do
     [ -n "${lsha:-}" ] || continue
     if [ "$rref" != refs/heads/integration ]; then echo "prepush-check: $rref: no quick check (only for integration)" >&2; continue; fi
     [ "$lsha" = "$Z" ] && continue                       # a delete
+    if server_runs_qc "$lsha" "$rsha"; then
+        echo "prepush-check: QUICK PASS ${lsha:0:7} deferred, quick check: server runs it (box update hook ${SH:0:12} = tools/update.hook of ${SC:0:7})" >&2
+        continue
+    fi
     W="$GC/x0x37-quickcheck/wt"
     if [ -d "$W" ]; then env -u GIT_DIR git -C "$W" checkout -q -f --detach "$lsha" || { rc=1; continue; }
     else mkdir -p "$GC/x0x37-quickcheck"; git worktree prune; git worktree add -q --detach "$W" "$lsha" || { rc=1; continue; }; fi
