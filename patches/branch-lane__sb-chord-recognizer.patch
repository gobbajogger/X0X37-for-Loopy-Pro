+P0=$(stat -c %a "$DEST")
+chmod u+w "$DEST" || { echo "install_gate: NOT INSTALLED: cannot write $DEST"; exit 1; }
+ok=1
+for p in "gate.sh x0x37_gate.sh" "gate_flashmap.py gate_flashmap.py"; do
+    set -- $p
+    t="$DEST/.$2.new.$$"
+    cp "$SRC/$1" "$t" && chmod 555 "$t" && mv -f "$t" "$DEST/$2" && cmp -s "$SRC/$1" "$DEST/$2" || { ok=0; rm -f "$t"; }
+done
+chmod "$P0" "$DEST"
+flock -u 9; exec 9>&-
+[ "$ok" = 1 ] || { echo "install_gate: FAILED: a file did not install (see $DEST)"; exit 1; }
+echo "install_gate: INSTALLED $(sha256sum "$DEST/x0x37_gate.sh" | cut -c1-12) x0x37_gate.sh, $(sha256sum "$DEST/gate_flashmap.py" | cut -c1-12) gate_flashmap.py in $DEST (folder mode $P0, waited $(( $(date +%s) - T0 )) s)"
