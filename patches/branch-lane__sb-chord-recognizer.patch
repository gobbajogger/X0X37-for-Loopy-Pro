+ * A valid nonzero buffer is always terminated. Invalid results format as "-". */
+CK_CD_FN static void ck_chord_format(const ck_chord_result_t *ch, char *out, uint32_t capacity)
+{
+    const char *name = CK_CD_NAMES;
