+def read_ctl(ed, size):
+    """the first size bytes of the unit's Bluetooth block (ED_CTL_READ)"""
+    got = bytearray()
+    while len(got) < size:
+        off, n = len(got), min(CTL_READ_N, size - len(got))
+        r = xs.req(ed, ED_CTL_READ, [off & 0x7F, (off >> 7) & 0x7F, (off >> 14) & 0x7F, (n + 1) // 2],
