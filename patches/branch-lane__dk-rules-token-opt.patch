index 0000000..1308820
--- /dev/null
+++ b/tools/gate_flashmap.py
@@ -0,0 +1,57 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+"""Check the SMK-37 flash map in firmware/hal/fm1_flash_map.h (read only).
+
+The check finds overlaps between the regions of the BOARD_SMK37 map.
+It also compares the map with the layout that the owner approved (a65 and later):
+one Bluetooth block of 64 KiB at 0x8B000, the store at 0x9D000-0xAFFFF (with the owner tag at 0xAF000),
+slot 3 of 44 KiB at 0xB0000-0xBAFFF, no piece 2 (FL_CTL2) and no FL_BOND.
+The owner tag (ST_OWNER_SECTOR in firmware/src/storage.c) must be at 0xAF000, in the last sector of the store.
+  tools/gate_flashmap.py firmware/hal/fm1_flash_map.h [firmware/src/storage.c]
+The last line is "flashmap: PASS" or "flashmap: FAIL <reason>". The exit code is 0 or 1."""
+import os
+import re
+import sys
+
+src = open(sys.argv[1]).read()
+start = src.index("#if BOARD_SMK37")
+smk = src[start:src.index("#else", src.index("FL_GUARD", start))]
+d = {k: int(v, 16) for k, v in re.findall(r"#define (FL_\w+)\s+0x([0-9A-Fa-f]+)u", smk)}
+errors = []
+regions = [("head", 0, d["FL_HEAD_HI"]), ("app code", 0x4120, d["FL_BLE_LO"]),
+           ("Bluetooth block", d["FL_BLE_LO"], d["FL_BLE_HI"]), ("app slot end and cfg", d["FL_BLE_HI"], d["FL_APP_HI"]),
+           ("store", d["FL_DATA_LO"], d["FL_DATA_HI"]), ("slot 3", d["FL_SMPV_LO"], d["FL_SMPV_HI"]),
+           ("OTA", d["FL_OTA_LO"], d["FL_OTA_HI"]), ("BTIF and USRTRIM", d["FL_CAL_LO"], d["FL_CAL_HI"]),
+           ("slots 1 and 2", d["FL_SMP_LO"], d["FL_SMP_HI"]), ("USR", d["FL_USRRES_LO"], d["FL_USRRES_HI"]),
+           ("key_mac", d["FL_KEYMAC_LO"], 0x100000)]
+if "FL_CTL2_LO" in d:
+    regions += [("piece 2", d["FL_CTL2_LO"], d["FL_CTL2_HI"])]
+    errors.append("piece 2 (FL_CTL2) exists")
+if "FL_BOND_LO" in d:
+    regions += [("bonds", d["FL_BOND_LO"], d["FL_BOND_HI"])]
+    errors.append("FL_BOND exists")
+regions.sort(key=lambda r: (r[1], r[2]))
+for name, lo, hi in regions:
+    print(f"  {lo:#08x}-{hi - 1:#08x} {(hi - lo) // 1024:4d} KiB  {name}")
+for a, b in zip(regions, regions[1:]):
+    if a[2] > b[1]:
+        errors.append(f"overlap {a[0]} / {b[0]}")
+expect = {"FL_BLE_LO": 0x8B000, "FL_BLE_HI": 0x9B000, "FL_DATA_LO": 0x9D000, "FL_DATA_HI": 0xB0000,
+          "FL_SMPV_LO": 0xB0000, "FL_SMPV_HI": 0xBB000}
+for k, v in expect.items():
+    if d.get(k) != v:
+        errors.append(f"{k} is {d.get(k, 0):#x}, expected {v:#x}")
+st_path = sys.argv[2] if len(sys.argv) > 2 else os.path.join(os.path.dirname(sys.argv[1]), "..", "src", "storage.c")
+m = re.search(r"#define ST_OWNER_SECTOR\s+0x([0-9A-Fa-f]+)u?", open(st_path).read()) if os.path.exists(st_path) else None
+if not m:
+    errors.append(f"no ST_OWNER_SECTOR in {st_path}")
+else:
+    owner = int(m.group(1), 16)
+    print(f"owner tag (ST_OWNER_SECTOR): {owner:#x}")
+    if owner != 0xAF000:
+        errors.append(f"ST_OWNER_SECTOR is {owner:#x}, expected 0xaf000")
+    if not (d["FL_DATA_LO"] <= owner and owner + 0x1000 <= d["FL_DATA_HI"]):
+        errors.append(f"ST_OWNER_SECTOR {owner:#x} is not in the store")
+print(f"slot 3: {d['FL_SMPV_LO']:#x}-{d['FL_SMPV_HI'] - 1:#x}, {(d['FL_SMPV_HI'] - d['FL_SMPV_LO']) // 1024} KiB")
+print("flashmap: PASS" if not errors else "flashmap: FAIL " + "; ".join(errors))
+sys.exit(1 if errors else 0)
diff --git a/tools/gate_sigwrap.py b/tools/gate_sigwrap.py
new file mode 100644
index 0000000..89d13b1
--- /dev/null
+++ b/tools/gate_sigwrap.py
@@ -0,0 +1,69 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+"""gate_sigwrap.py: record who stops the gate (check 5 of rules v4, rule 2: no pkill -f).
+
+  gate_sigwrap.py SIGFILE COMMAND [ARG ...]
+
+tools/gate.sh (x0x37_gate.sh) runs itself through this wrapper with exec, so the wrapper keeps the PID of the gate.
+The wrapper starts COMMAND (the gate) as its child and waits. On SIGTERM, SIGINT or SIGHUP it reads the sender of the
+signal (si_pid of the signal) and writes one line to SIGFILE:
+    sig=SIGTERM pid=<sender PID> cwd=<sender working folder> cmd=<sender command line>
+(cwd and cmd are "?" if the sender process has stopped). Then it sends the same signal to the child. The gate trap
+(on_signal in gate.sh) reads SIGFILE and writes the sender to the gate.log KILLED line and to the KILLED output line.
+Exit code: the exit code of the child (128 + N if a signal N stopped it). The wrapper removes SIGFILE at the end.
+"""
+import os
+import signal
+import subprocess
+import sys
+
+STOP = {signal.SIGTERM, signal.SIGINT, signal.SIGHUP}
+
+
+def proc(pid, what):
+    try:
+        if what == "cwd":
+            return os.readlink(f"/proc/{pid}/cwd")
+        with open(f"/proc/{pid}/cmdline", "rb") as f:
+            return f.read().replace(b"\0", b" ").decode("utf-8", "replace").strip()[:200] or "?"
+    except OSError:
+        return "?"
+
+
+def main(argv):
+    if len(argv) < 3:
+        print(__doc__, file=sys.stderr)
+        return 2
+    sigfile, cmd = argv[1], argv[2:]
+    waitset = STOP | {signal.SIGCHLD}
+    signal.pthread_sigmask(signal.SIG_BLOCK, waitset)
+    child = subprocess.Popen(cmd, preexec_fn=lambda: signal.pthread_sigmask(signal.SIG_UNBLOCK, waitset))
+    try:
+        while True:
+            info = signal.sigwaitinfo(waitset)
+            if info.si_signo == signal.SIGCHLD:
+                if child.poll() is not None:
+                    break
+                continue
+            pid = info.si_pid
+            line = (f"sig={signal.Signals(info.si_signo).name} pid={pid} cwd={proc(pid, 'cwd')} "
+                    f"cmd={proc(pid, 'cmd')}\n")
+            tmp = f"{sigfile}.tmp"
+            with open(tmp, "w") as f:
+                f.write(line)
+            os.replace(tmp, sigfile)
+            try:
+                os.kill(child.pid, info.si_signo)
+            except ProcessLookupError:
+                pass
+        rc = child.returncode
+    finally:
+        try:
+            os.unlink(sigfile)
+        except OSError:
+            pass
+    return 128 - rc if rc < 0 else rc
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
diff --git a/tools/install_gate.sh b/tools/install_gate.sh
new file mode 100755
index 0000000..b4b44cf
--- /dev/null
+++ b/tools/install_gate.sh
@@ -0,0 +1,48 @@
+#!/bin/bash
+# SPDX-License-Identifier: GPL-3.0-only
+# Install the gate (tools/gate.sh as x0x37_gate.sh, tools/gate_sigwrap.py, tools/gate_flashmap.py, tools/prepush-check.sh, tools/quickcheck.sh, tools/ste_check.py and tools/prefs_lint.py) into the shared gate folder.
+#   tools/install_gate.sh
+# The install starts only when the gate lock is free (flock -n) AND no x0x37_gate.sh process runs (pgrep).
+# It holds the lock during the install. Each file goes to a temp file in the same folder, gets mode 555 and
+# replaces the old file with "mv -f" (a running bash never reads a half-written script). The folder mode is
+# restored after the install. If the gate is busy, the script waits (5 s steps, at most X0X_INSTALL_WAIT seconds)
+# and then stops with "NOT INSTALLED" and the reason. Exit code 0 (installed) or 1.
+# Environment (defaults in brackets): X0X_GATE_DEST [/workspace/x0x37-refs/gate]
+#   X0X_GATE_LOCK [/workspace/x0x37-refs/gate.lock]  X0X_INSTALL_WAIT [1800]
+set -u
+SRC=$(cd "$(dirname "$0")" && pwd)
+DEST=${X0X_GATE_DEST:-/workspace/x0x37-refs/gate}
+GLOCK=${X0X_GATE_LOCK:-/workspace/x0x37-refs/gate.lock}
+MAX=${X0X_INSTALL_WAIT:-1800}
+for f in gate.sh gate_sigwrap.py gate_flashmap.py prepush-check.sh quickcheck.sh ste_check.py prefs_lint.py pre-push.hook; do [ -f "$SRC/$f" ] || { echo "install_gate: NOT INSTALLED: no $SRC/$f"; exit 1; }; done
+bash -n "$SRC/gate.sh" || { echo "install_gate: NOT INSTALLED: syntax error in $SRC/gate.sh"; exit 1; }
+[ -d "$DEST" ] || { echo "install_gate: NOT INSTALLED: no folder $DEST"; exit 1; }
+exec 9>>"$GLOCK" || { echo "install_gate: NOT INSTALLED: cannot open $GLOCK"; exit 1; }
+T0=$(date +%s); SAID=""
+while :; do
+    WHY=""
+    if ! flock -n 9; then WHY="the gate lock $GLOCK is held"
+    else
+        RUN=$(pgrep -af '/?x0x37_gate\.sh( |$)' | grep -v -e pgrep -e install_gate)
+        [ -z "$RUN" ] || { WHY="a gate runs: $(echo "$RUN" | head -1 | cut -c1-120)"; flock -u 9; }
+    fi
+    [ -z "$WHY" ] && break
+    if [ $(( $(date +%s) - T0 )) -ge "$MAX" ]; then
+        echo "install_gate: NOT INSTALLED after $(( $(date +%s) - T0 )) s: $WHY"; exit 1
+    fi
+    [ "$SAID" = "$WHY" ] || { echo "install_gate: waiting ($WHY)" >&2; SAID=$WHY; }
+    sleep 5
+done
+# the lock is held and no gate runs
+P0=$(stat -c %a "$DEST")
+chmod u+w "$DEST" || { echo "install_gate: NOT INSTALLED: cannot write $DEST"; exit 1; }
+ok=1
+for p in "gate.sh x0x37_gate.sh" "gate_sigwrap.py gate_sigwrap.py" "gate_flashmap.py gate_flashmap.py" "prepush-check.sh prepush-check.sh" "quickcheck.sh quickcheck.sh" "ste_check.py ste_check.py" "prefs_lint.py prefs_lint.py" "pre-push.hook pre-push.hook"; do
+    set -- $p
+    t="$DEST/.$2.new.$$"
+    cp "$SRC/$1" "$t" && chmod 555 "$t" && mv -f "$t" "$DEST/$2" && cmp -s "$SRC/$1" "$DEST/$2" || { ok=0; rm -f "$t"; }
+done
+chmod "$P0" "$DEST"
+flock -u 9; exec 9>&-
+[ "$ok" = 1 ] || { echo "install_gate: FAILED: a file did not install (see $DEST)"; exit 1; }
+echo "install_gate: INSTALLED $(sha256sum "$DEST/x0x37_gate.sh" | cut -c1-12) x0x37_gate.sh, $(sha256sum "$DEST/gate_sigwrap.py" | cut -c1-12) gate_sigwrap.py, $(sha256sum "$DEST/gate_flashmap.py" | cut -c1-12) gate_flashmap.py, $(sha256sum "$DEST/prepush-check.sh" | cut -c1-12) prepush-check.sh, $(sha256sum "$DEST/quickcheck.sh" | cut -c1-12) quickcheck.sh, $(sha256sum "$DEST/ste_check.py" | cut -c1-12) ste_check.py, $(sha256sum "$DEST/prefs_lint.py" | cut -c1-12) prefs_lint.py in $DEST (folder mode $P0, waited $(( $(date +%s) - T0 )) s)"
