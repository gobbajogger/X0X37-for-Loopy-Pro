From 15789aa13b9b292c405e45bbbf00eec099078ea8 Mon Sep 17 00:00:00 2001
From: genkigenki <3080081+genkigenki@users.noreply.github.com>
Date: Fri, 16 Oct 2026 19:11:43 +1000
Subject: [PATCH 2/4] Share one 4 KiB main-loop scratch between ota_stage and
 lz_head.

ota.c and lz.c never run at the same time in the main loop.
The decoded update message also uses that scratch.
This frees 2688 B of static RAM.
---
 firmware/src/app/lz.c |  4 ++++
 firmware/src/ota.c    | 12 ++++++++++--
 firmware/src/x0x.c    |  9 +++++++++
 3 files changed, 23 insertions(+), 2 deletions(-)

diff --git a/firmware/src/app/lz.c b/firmware/src/app/lz.c
index 78a94ee..df4b668 100644
--- a/firmware/src/app/lz.c
+++ b/firmware/src/app/lz.c
@@ -30,7 +30,11 @@ typedef struct {
     void *ctx;
 } lz_src_t;
 
+#ifdef LZ_SCRATCH                      /* the app: a main-loop scratch that it shares (4 KiB) */
+#define lz_head LZ_SCRATCH
+#else
 static uint16_t lz_head[1u << LZ_HBITS];
+#endif
 
 static uint32_t lz_hash(const uint8_t *p)
 {
diff --git a/firmware/src/ota.c b/firmware/src/ota.c
index e1effa7..b03c568 100644
--- a/firmware/src/ota.c
+++ b/firmware/src/ota.c
@@ -117,7 +117,11 @@ static uint32_t ota_unpack7(const uint8_t *in, uint32_t n, uint8_t *out, uint32_
 }
 
 static uint8_t ota_msg[8 + 32], ota_wire[2 + 48];
+#ifdef OTA_SCRATCH                               /* the app: after the session buffers in the scratch */
+#define ota_dec (OTA_SCRATCH + 0x800)
+#else
 static uint8_t ota_dec[OTA_FRAME_MAX];           /* decoded host message */
+#endif
 
 static int ota_send_msg(uint32_t cmd, const uint8_t *body, uint32_t n)   /* n <= 32 */
 {
@@ -156,9 +160,9 @@ static uint32_t ota_take(void)
     uint32_t n, d, s = 0, i;
     if (!ota_frame_get(&p, &n))
         return 0;
-    d = ota_unpack7(p, n, ota_dec, sizeof ota_dec);
+    d = ota_unpack7(p, n, ota_dec, OTA_FRAME_MAX);
     ota_frame_done();
-    if (d < 7u || d > sizeof ota_dec || ota_dec[0] != 0 || ota_dec[1] != 0x59 || ota_rd24(ota_dec + 3) + 7u != d)
+    if (d < 7u || d > OTA_FRAME_MAX || ota_dec[0] != 0 || ota_dec[1] != 0x59 || ota_rd24(ota_dec + 3) + 7u != d)
         return 0;
     for (i = 6; i + 1u < d; i++)
         s += ota_dec[i];
@@ -270,7 +274,11 @@ static int ota_ufw(uint8_t *hdr, uint32_t *fl_off, uint32_t *fl_len, uint32_t *o
 
 static int ota_stage(void)                       /* steps 1..6; 0 = host said success */
 {
+#ifdef OTA_SCRATCH                     /* the app: a main-loop scratch that it shares (2 KiB used) */
+    uint8_t *const hdr = OTA_SCRATCH, *const b = hdr + 0x400, *const mine = b + 512;
+#else
     static uint8_t hdr[0x400], b[512], mine[512];
+#endif
     uint32_t i, n, ota_off, ota_len, fl_off, fl_len, c, len, own, official;
     int rc;
     /* 1. UFW header + entry list */
diff --git a/firmware/src/x0x.c b/firmware/src/x0x.c
index a4fea6d..7fe41c5 100644
--- a/firmware/src/x0x.c
+++ b/firmware/src/x0x.c
@@ -106,6 +106,15 @@ static int st_prog(uint32_t off, const void *src, uint32_t n)
 
 struct bootguard_s { uint32_t magic, failed, pending; };
 extern struct bootguard_s bootguard;
+/* One 4 KiB scratch for two main-loop jobs that never run at the same time: the LZ hash table of a
+ * project save (lz.c) and the read buffers of an update session (ota.c). Both run only from the
+ * main loop, to completion, and neither calls the other. ota.c uses 0x000-0x7FF for its session
+ * buffers and 0x800-0xA7F for the decoded host message (OTA_FRAME_MAX); a save may overwrite
+ * that message, which is only read in the call that decoded it. */
+_Static_assert(0x800 + 640 <= 4096, "scratch");
+static uint16_t x0x_main_scratch[2048] __attribute__((aligned(4)));
+#define OTA_SCRATCH ((uint8_t *)x0x_main_scratch)
+#define LZ_SCRATCH x0x_main_scratch
 #include "ota.c"
 static uint32_t ota_now_ms(void) { return fm1_ms; }
 static void ota_idle(void) { fm1_wdt_feed(); }
-- 
