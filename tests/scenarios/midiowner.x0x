# BF-004: stale Note Off from a previous USB/Bluetooth source must not silence the current owner.
# midiheld: bit 0 the 303A gate, bit 1 the 303B gate, bit 8 + s the break slice key s.
# Default channels (MID-02): 303A 2 (0x91/0x81), BREAK 4 (0x93/0x83, slices on notes 36-43).
# midi S D1 D2 SRC: SRC 0 USB, 1 Bluetooth, 2 TRS.
wait 300
expect midiheld 0

# 303A: USB Note On, Bluetooth takes the same pitch, stale USB Note Off must leave the hold
midi 91 30 64 0
wait 20
expect midiheld 1
midi 91 30 64 1
wait 20
expect midiheld 1
midi 81 30 00 0
wait 20
expect midiheld 1
# owner (Bluetooth) Note Off releases
midi 81 30 00 1
wait 20
expect midiheld 0

# BREAK slice 0: same stale non-owner Note Off must leave the slice held
midi 93 24 64 0
wait 20
expect midiheld 0x100
midi 93 24 64 1
wait 20
expect midiheld 0x100
midi 83 24 00 0
wait 20
expect midiheld 0x100
midi 83 24 00 1
wait 20
expect midiheld 0

# different-note control: USB holds pitch 0x30; Bluetooth Note Off of 0x31 does nothing
midi 91 30 64 0
wait 20
expect midiheld 1
midi 81 31 00 1
wait 20
expect midiheld 1
midi 81 30 00 0
wait 20
expect midiheld 0

# same-owner release: USB Note On then USB Note Off
midi 91 32 64 0
wait 20
expect midiheld 1
midi 81 32 00 0
wait 20
expect midiheld 0

# reverse ownership: Bluetooth first, USB takes over, stale Bluetooth Note Off ignored
midi 91 33 64 1
midi 91 33 64 0
wait 20
expect midiheld 1
midi 81 33 00 1
wait 20
expect midiheld 1
midi 81 33 00 0
wait 20
expect midiheld 0

# TRS (src 2): Note Off still releases a TRS-held note
midi 91 34 64 2
wait 20
expect midiheld 1
midi 81 34 00 2
wait 20
expect midiheld 0

# TRS takes over from USB: stale USB Note Off ignored; TRS Note Off releases
midi 91 35 64 0
midi 91 35 64 2
wait 20
expect midiheld 1
midi 81 35 00 0
wait 20
expect midiheld 1
midi 81 35 00 2
wait 20
expect midiheld 0
