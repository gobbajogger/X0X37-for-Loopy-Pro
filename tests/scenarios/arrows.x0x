# a77: the SMK-37 "<" and ">" (smk_arrows.h, as main_fm1.c smk_arrows does after each frame).
# In a menu list (GLO, the list of a page) they step the value of the selected row, as ALGORITHM.
# A held arrow repeats: the first repeat after 400 ms, then one step each 80 ms. The value stops at its ends.
# Action rows do not run. With no menu, the arrows move SELECT one detent for each press (GEN-29).
wait 300
tap EDIT
expect setsize 40
expect setbyte27 8
# no menu, clip mode off: one SELECT detent for each press, no repeat
expect overlay 0
expect page 0
arrow R tap
expect page 1
arrow R down
wait 1500
arrow R up
expect page 2
arrow L tap
expect page 1
arrow L tap
expect page 0
expect arrowsteps 4
# GLO opens its sections. ">" enters a section. In a section ">" steps the value of the row up;
# "<" goes back out to the sections, as HOME, and never edits a row. A held entry or exit arrow
# is consumed until release.
tap GLO
expect view 5
expect overlay 1
expect listsel 0
arrow R tap
expect listsel 0
expect clksrc 0
arrow R tap
expect clksrc 1
expect listsel 0
arrow R tap
expect clksrc 2
arrow R tap
expect clksrc 2
expect setbyte27 12
arrow L tap
expect overlay 1
expect listsel 0
expect clksrc 2
arrow R tap
turn ALGO -2
expect clksrc 0
expect listsel 0
expect setbyte27 8
# held ">" entry and held "<" exit do not edit CLOCK SOURCE
arrow L tap
arrow R down
wait 1000
arrow R up
expect clksrc 0
wait 100
arrow R tap
expect clksrc 1
turn ALGO -1
arrow L down
wait 1000
arrow L up
expect clksrc 0
expect listsel 0
arrow R tap
# hold repeat on MIDI CH 909 (10, range OFF 0 .. 16)
turn SELECT 3
expect listsel 3
expect rowval 10
arrow R down
wait 20
expect rowval 11
wait 340
expect rowval 11
wait 80
expect rowval 12
wait 240
expect rowval 15
wait 2000
expect rowval 16
arrow R up
expect rowval 16
arrow R tap
expect rowval 16
turn ALGO -16
expect rowval 0
arrow R tap
expect rowval 1
turn ALGO 9
expect rowval 10
expect listsel 3
# Action rows do not run: PROJECT > SAVE, CLEAR PATTERN, RESET PROJECT; SYSTEM > PERFORMANCE.
arrow L tap
turn SELECT 3
expect listsel 3
arrow R tap
expect listsel 0
expect store_writes 0
arrow R tap
arrow R down
wait 1000
arrow R up
expect store_writes 0
expect overlay 1
# Skip LOAD SAVED and AUTOSAVE to reach CLEAR PATTERN.
turn SELECT 3
expect listsel 3
arrow R tap
arrow R down
wait 1000
arrow R up
expect overlay 1
turn SELECT 1
expect listsel 4
arrow R tap
expect overlay 1
arrow L tap
expect listsel 3
turn SELECT 1
arrow R tap
expect listsel 0
arrow R tap
expect overlay 1
expect view 5
expect listsel 0
# Back to MIDI + CLOCK: it remembers MIDI CH 909, three rows below CLOCK SOURCE.
arrow L tap
turn SELECT -4
arrow R tap
expect listsel 3
turn SELECT -3
expect listsel 0
expect clksrc 0
# clip mode, GLO open: one press gives one step (only smk_arrows reads the arrows), and a hold repeats
clipmode 1
arrow R tap
expect clksrc 1
arrow R down
wait 450
arrow R up
expect clksrc 2
arrow L tap
expect listsel 0
arrow R tap
turn ALGO -2
expect clksrc 0
# clip mode, no menu: smk_arrows gives no step (the clip keys page takes < and >, CLP-76; not in the host)
tap GLO
expect overlay 0
expect page 0
arrow R tap
arrow L down
wait 1000
arrow L up
expect page 0
expect arrowsteps 79
clipmode 0
# HOME held: the arrows do nothing (SELECT is the tempo)
tap GLO
expect overlay 1
expect listsel 0
expect tempo 125
press HOME
arrow R tap
arrow R down
wait 1000
arrow R up
expect clksrc 0
expect tempo 125
expect arrowsteps 79
release HOME
expect setsize 40
expect setbyte27 8
# the list of a page (SEL): the same. A wide value (0-127) steps one at a time (no knob acceleration)
tap GLO
expect overlay 0
expect view 1
tap SEL
expect overlay 1
expect listsel 1
expect rowval 34
arrow R tap
expect rowval 35
expect listsel 1
arrow R down
wait 450
arrow R up
expect rowval 37
arrow L tap
arrow L tap
arrow L tap
expect rowval 34
expect listsel 1
