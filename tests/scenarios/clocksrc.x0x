shot 04_following.png
# the clock stops: X0X pauses and waits; the tempo keeps the measured one (about 139 BPM)
wait 700
expect playing 1
expect waiting 1
expect tempo >130
tap PLAY
wait 100
expect playing 0
expect transport_out 0
# INTERNAL: Start, Clock and Stop in are ignored; PLAY runs on the internal clock with clock out
tap GLO
# GLOBAL opens its sections; SEL enters MIDI + CLOCK (CLOCK SOURCE is row 0)
tap SEL
turn ALGO -1
tap GLO
expect clksrc 1
