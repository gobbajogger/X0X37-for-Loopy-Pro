# saved after power-off (autosave)
wait 6000
reboot
wait 300
expect clksrc 1
# an older save: the padding byte at offset 38 (payload byte 42) is 0 or 0xFF: AUTO
storepoke 0 42 FF
reboot
wait 300
expect clksrc 0
storepoke 0 42 02
reboot
wait 300
expect clksrc 2
storepoke 0 42 00
reboot
wait 300
expect clksrc 0
# a project saved by X0X 0.10: AUTO
storeload tests/fixtures/v1_store.bin
wait 100
expect clksrc 0
