shot 05_internal.png
tap PLAY
wait 100
expect playing 0
expect transport_out 2
# saved after power-off (autosave)
wait 6000
reboot
wait 300
expect clksrc 1
# a75: settings bt (payload byte 31) bits 1-2 hold the value, bit 3 marks it; a value of 3 loads AUTO
expect storeset31 10
storepoke 0 31 0E
reboot
wait 300
expect clksrc 0
storepoke 0 31 0C
reboot
wait 300
expect clksrc 2
storepoke 0 31 08
reboot
wait 300
expect clksrc 0
# older saves (a74 byte 38, a73, clip keys): tests/scenarios/clkmove.x0x
# a project saved by X0X 0.10: AUTO
storeload tests/fixtures/v1_store.bin
wait 100
expect clksrc 0
