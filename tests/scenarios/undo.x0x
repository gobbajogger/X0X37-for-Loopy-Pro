# Undo / redo (HOME + REC / HOME + PLAY): a step is one gesture, what changed between quiet moments.
wait 300
expect sound0.0.0 34
# gesture 1: kick on steps 1 and 5; gesture 2: step 9; gesture 3: BD tune up
tapkey b0
tapkey w0
tapkey w4
wait 600
tapkey w8
wait 600
# the tune knob is on EDIT (the sound page); SEQ is back for the steps
tap EDIT
turn K1 5
wait 600
tap SEQ
expect hit0.0.8 1
expect sound0.0.0 39
# undo the tune, then step 9, then steps 1 and 5
press HOME
tap REC
release HOME
expect sound0.0.0 34
press HOME
tap REC
release HOME
expect hit0.0.8 0
expect hit0.0.4 1
press HOME
tap REC
release HOME
expect hit0.0.0 0
expect hit0.0.4 0
expect playing 0
expect rec 0
# redo two: steps 1, 5 and 9 back, the tune still undone
press HOME
tap PLAY
release HOME
press HOME
tap PLAY
release HOME
expect hit0.0.0 1
expect hit0.0.8 1
expect sound0.0.0 34
expect playing 0
# a new edit after an undo drops the redo
press HOME
tap REC
release HOME
expect hit0.0.8 0
tapkey w12
wait 600
press HOME
tap PLAY
release HOME
expect hit0.0.8 0
expect hit0.0.12 1
# RESET PROJECT clears the old undo/redo history and creates a fresh default baseline.
# Change a sound and tempo too, so clearing only the current pattern cannot satisfy the reset checks.
tap EDIT
turn K1 7
wait 600
expect sound0.0.0 41
tap SEQ
press HOME
turn SELECT 5
release HOME
expect tempo 130
# GLO > RESET PROJECT (+17 selectable rows from CLOCK SOURCE), then confirm.
tap GLO
# GLOBAL > PROJECT (section 3) > RESET PROJECT (row 4)
turn SELECT 3
tap SEL
turn SELECT 4
expect listsel 4
tap SEL
expect overlay 2
tap SEL
wait 600
expect overlay 0
expect hit0.0.0 0
expect hit0.0.12 0
expect sound0.0.0 34
expect tempo 125
expect playing 0
expect rec 0
press HOME
tap REC
release HOME
expect hit0.0.0 0
expect hit0.0.12 0
expect sound0.0.0 34
expect tempo 125
press HOME
tap PLAY
release HOME
expect hit0.0.0 0
expect hit0.0.12 0
expect playing 0
# A new gesture after reset can still be undone and redone without reviving the old project.
tapkey b0
tapkey w0
wait 600
expect hit0.0.0 1
press HOME
tap REC
release HOME
expect hit0.0.0 0
press HOME
tap PLAY
release HOME
expect hit0.0.0 1
expect hit0.0.12 0
expect sound0.0.0 34
expect tempo 125
