# EDIT may finish an onset started on SEQ; new MIDI onsets cannot write hidden steps.
wait 300
turn ALGO 2
tap EDIT
expect view 1
tap REC
tap PLAY
midi 91 30 64
wait 300
midi 81 30 00
expect gate0.0 0
expect gate0.1 0
tap SEQ
expect view 8
midi 91 30 64
wait 80
tap EDIT
expect view 1
wait 300
midi 81 30 00
expect gate0.4 1
expect gate0.5 2
expect gate0.7 2
midi 91 32 64
wait 230
midi 81 32 00
expect gate0.9 0
expect gate0.10 0
