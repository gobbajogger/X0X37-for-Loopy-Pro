# Revision 13 CLOCK SOURCE persistence and normalization; clip-key bytes stay independent.
wait 300
expect clksrc 0
expect setbyte27 8
expect setbyte38 0
# a75 save: EXTERNAL is in bt, byte 38 stays 0
tap GLO
turn ALGO 2
tap HOME
expect clksrc 2
wait 6000
expect storeset31 12
expect storeset42 0
expect storeset43 0
# with the mark, a load does not read byte 38 (after the merge: ck_x1 SWING 2)
storepoke 0 31 0A
storepoke 0 42 02
storepoke 0 43 00
reboot
wait 300
expect clksrc 1
expect setbyte38 2
# with the mark, a value of 3 in bits 1-2 loads AUTO; BLUETOOTH and the mark stay
storepoke 0 31 0F
reboot
wait 300
expect clksrc 0
expect setbyte27 9
