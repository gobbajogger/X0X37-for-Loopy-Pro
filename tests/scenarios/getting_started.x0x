# Getting started adapted to the current Miami/Chicago panel metadata.
wait 300
# 1. X0X opens on the 909, every part empty. A kick: black key 1 (heard), white keys 1, 5, 9, 13
expect view 8
expect part 0
peakreset
tapkey b0
expect peak_db_min -40
tapkey w0
tapkey w4
tapkey w8
tapkey w12
expect hit0.0.0 1
expect hit0.0.12 1
# 2. PLAY
tap PLAY
wait 500
expect playing 1
# 3. a clap: black key 7, white keys 5 and 13
tapkey b6
tapkey w4
tapkey w12
expect hit0.6.4 1
expect hit0.6.12 1
# 4. open hats: black key 9, white keys 3, 7, 11, 15
tapkey b8
tapkey w2
tapkey w6
tapkey w10
tapkey w14
expect hit0.8.2 1
expect hit0.8.14 1
# 5. write a Miami A line: ALGORITHM four clicks clockwise, ARP, OCT+
turn ALGO 4
expect part 2
tap ARP
expect view 2
tap OCT+
# 6. Miami FILTER is page 2: KNOB 1 cutoff, KNOB 2 crush.
# Seed known control positions so the ten-detent changes remain exact.
tap EDIT
expect view 1
tap EDIT
tap EDIT
expect page 2
param 2 0 9 48
param 2 0 10 100
turn K1 10
turn K2 -10
tap SEL
turn SELECT 8
expect rowval 58
turn SELECT 1
expect rowval 90
tap HOME
# 7. the break: ALGORITHM two clicks counterclockwise to BREAK, all sixteen white keys
turn ALGO -2
expect part 4
tapkey w0
tapkey w1
tapkey w2
tapkey w3
tapkey w4
tapkey w5
tapkey w6
tapkey w7
tapkey w8
tapkey w9
tapkey w10
tapkey w11
tapkey w12
tapkey w13
tapkey w14
tapkey w15
expect brk0 1
expect brk15 1
# 8. mute the break: HOME, black key 3 (and again to bring it back)
tap HOME
expect view 0
tapkey b2
expect mute 16777216
tapkey b2
expect mute 0
# 9. record a filter sweep: ALGORITHM back to 303A, EDIT, REC, turn KNOB 1, REC
turn ALGO 2
tap EDIT
expect part 2
expect view 1
tap REC
turn K1 -20
tap REC
expect lanes 1
shot gs_motion.png
# 10. save
tap PLAY
tap SAVE
wait 100
expect store_writes 6
