# Revision 13 deliberately rejects v0102_store.bin; it never migrates or overwrites it.
wait 300
storeload tests/fixtures/v0102_store.bin
wait 300
expect pattern 1
expect tempo 125
expect hit0.0.0 0
expect hit0.0.31 0
expect hit0.0.63 0
expect gate0.0 0
expect lanes 0
expect songlen 0
expect clksrc 0
expect sound0.1.3 41
expect sound0.1.4 58
expect store_writes 0
# Neither idle autosave nor explicit SAVE may replace the unsupported store.
wait 25000
expect store_writes 0
tap SAVE
wait 300
expect savestate 3
expect store_writes 0
reboot
wait 300
expect tempo 125
expect lanes 0
expect songlen 0
expect hit0.0.0 0
expect store_writes 0
# Explicit RESET PROJECT is the supported adoption boundary (SET-07).
tap GLO
turn SELECT 17
expect listsel 21
tap SEL
expect overlay 2
tap SEL
wait 100
expect overlay 0
expect playing 0
expect rec 0
# Author a current project from panel controls and check its save/reload.
tap SEQ
tapkey b0
tapkey w0
tapkey w12
expect hit0.0.0 1
expect hit0.0.12 1
press HOME
turn SELECT -5
release HOME
expect tempo 120
tap HOME
tap HOME
expect view 6
tapkey w0
tapkey w15
expect songlen 2
expect songbar2.0 16
tap SAVE
wait 300
expect savestate 0
expect store_writes 6
expect storeset23 13
reboot
wait 300
expect tempo 120
expect hit0.0.0 1
expect hit0.0.12 1
expect hit0.0.31 0
expect lanes 0
expect songlen 2
expect songbar2.0 16
expect store_writes 6
