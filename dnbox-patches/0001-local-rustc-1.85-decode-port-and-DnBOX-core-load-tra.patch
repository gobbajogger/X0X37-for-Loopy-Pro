+/// DnBOX gate instrumentation (local, read-only: it never changes timing or state).
+/// FM1_CORE_LOAD=LO-HI (hex, core 1's waiting-loop range, e.g. the ELF's .c1_text): after each of
+/// cpu1's slices, its pc says busy (outside LO..HI) or waiting; the slice's clock ticks go into
+/// bins of one audio half (512 frames at 44.1 kHz). `core_load::dump(path)` writes them as CSV.
+pub mod core_load {
+    use crate::Soc;
+    use std::sync::Mutex;
+    struct St { lo: u32, hi: u32, bin: u64, busy: Vec<u64>, tot: Vec<u64> }
+    static ST: Mutex<Option<St>> = Mutex::new(None);
+    static INIT: std::sync::Once = std::sync::Once::new();
+    fn init(soc: &Soc) {
+        INIT.call_once(|| {
+            if let Ok(v) = std::env::var("FM1_CORE_LOAD") {
+                if let Some((a, b)) = v.split_once('-') {
+                    let p = |x: &str| u32::from_str_radix(x.trim().trim_start_matches("0x"), 16).ok();
+                    if let (Some(lo), Some(hi)) = (p(a), p(b)) {
+                        let bin = soc.periph.hz * 512 / 44100;
+                        *ST.lock().unwrap() = Some(St { lo, hi, bin, busy: Vec::new(), tot: Vec::new() });
+                    }
+                }
+            }
+        });
+    }
+    pub fn note(soc: &Soc, pc: u32, from: u64, to: u64) {
+        init(soc);
+        let mut g = ST.lock().unwrap();
+        let Some(st) = g.as_mut() else { return };
+        let busy = !(st.lo..st.hi).contains(&pc);
+        let mut t = from;
+        while t < to {
+            let b = (t / st.bin) as usize;
+            let end = ((b as u64 + 1) * st.bin).min(to);
+            if st.tot.len() <= b { st.tot.resize(b + 1, 0); st.busy.resize(b + 1, 0); }
+            st.tot[b] += end - t;
+            if busy { st.busy[b] += end - t; }
+            t = end;
+        }
+    }
+    pub fn dump(path: &str) {
+        let g = ST.lock().unwrap();
+        let Some(st) = g.as_ref() else { return };
+        let mut out = String::from("bin,ms_start,core1_busy_ticks,core1_ticks\n");
+        for (i, (b, t)) in st.busy.iter().zip(&st.tot).enumerate() {
+            out += &format!("{i},{:.3},{b},{t}\n", i as f64 * 512.0 * 1000.0 / 44100.0);
+        }
+        let _ = std::fs::write(path, out);
+    }
+}
