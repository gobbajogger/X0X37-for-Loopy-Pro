+/// What an op costs on the chip, in sixteenths of a 360 MHz cycle (`Cpu::cost_model`), from harbor's
+/// cycles probe (2026-10-24, probes/cycles.c: one instruction a statement, run from RAM). The probe
+/// times are unchanged; they were first stored as eighths of a 240 MHz cycle (cost8). Odd cost8
+/// values are not integers times 1.5, so the unit is three times finer: cost16 = cost8 * 3.
+/// Wall time at --mhz 360 after this change equals wall time at --mhz 240 before it.
+/// Plain ALU ops ~0.6 of a 240 MHz cycle (two a cycle), a 6-byte constant 1.08, a multiply 1.9, a
+/// divide 6.75, loads 1.25, stores 1.4, a push or pop ~1.25 + 1 a register, a goto 5.2, a conditional
+/// branch taken 6.5 forward and ~4.75 backward (a loop's branch: the core predicts it), not taken
+/// 0.85, a call or a return ~5; (probes/cycles2.c) FPU add / subtract / multiply 1.375, divide 2.66,
+/// a 64-bit multiply(-accumulate) ~3.2. `taken`: it left its fall-through; `back`: to a lower
+/// address. Not in it: XIP's cache (fm1_soc's `XipCache`) and load-use stalls.
+fn op_cost16(f: &Fast, len: u8, taken: bool, back: bool) -> u32 {
+    let br = if back { 114 } else { 156 };
     let mask = |m: u16| m.count_ones();
     let range = |n: u8| (n as u32).saturating_sub(3);       // {rN-r4}: N - 3 registers
     match *f {
-        Fast::MovI { .. } if len >= 6 => 9,
+        Fast::MovI { .. } if len >= 6 => 27,
         Fast::Alu3 { op: Op::Mul, .. } | Fast::Alu3I { op: Op::Mul, .. } | Fast::Alu2 { op: Op::Mul, .. }
-        | Fast::Alu2I { op: Op::Mul, .. } => 15,
-        Fast::Div { .. } => 54,
+        | Fast::Alu2I { op: Op::Mul, .. } => 45,
+        Fast::Div { .. } => 162,
         Fast::Ld { .. } | Fast::LdW { .. } | Fast::LdWSp { .. } | Fast::LdBu { .. } | Fast::LdIdx { .. }
-        | Fast::LdPost { .. } | Fast::LdPre { .. } | Fast::LdPostR { .. } => 10,
+        | Fast::LdPost { .. } | Fast::LdPre { .. } | Fast::LdPostR { .. } => 30,
         Fast::St { .. } | Fast::StW { .. } | Fast::StWSp { .. } | Fast::StIdx { .. } | Fast::StPost { .. }
-        | Fast::StPre { .. } | Fast::StPostR { .. } => 11,
-        Fast::LdPair { .. } => 20,
-        Fast::StPair { .. } => 22,
-        Fast::Rmw { .. } => 21,
-        Fast::PushMask { mask: m } | Fast::PopMask { mask: m } => 10 + 8 * mask(m),
-        Fast::BlockMove { mask: m, .. } => 10 + 9 * mask(m),
-        Fast::PushRets { n } => 18 + 8 * range(n),
-        Fast::PopPc { n } => 50 + 8 * range(n),
-        Fast::PushRet | Fast::PopRets => 18,
-        Fast::PopRet => 50,
-        Fast::Call { .. } | Fast::CallR { .. } | Fast::Rts => 40,
-        Fast::Goto { .. } | Fast::GotoR { .. } | Fast::Tb { .. } => if back { 38 } else { 42 },
+        | Fast::StPre { .. } | Fast::StPostR { .. } => 33,
+        Fast::LdPair { .. } => 60,
+        Fast::StPair { .. } => 66,
+        Fast::Rmw { .. } => 63,
+        Fast::PushMask { mask: m } | Fast::PopMask { mask: m } => 30 + 24 * mask(m),
+        Fast::BlockMove { mask: m, .. } => 30 + 27 * mask(m),
+        Fast::PushRets { n } => 54 + 24 * range(n),
+        Fast::PopPc { n } => 150 + 24 * range(n),
+        Fast::PushRet | Fast::PopRets => 54,
+        Fast::PopRet => 150,
+        Fast::Call { .. } | Fast::CallR { .. } | Fast::Rts => 120,
+        Fast::Goto { .. } | Fast::GotoR { .. } | Fast::Tb { .. } => if back { 114 } else { 126 },
         Fast::BrI { .. } | Fast::BrR { .. } | Fast::BrIEq { .. } | Fast::BrINe { .. } | Fast::BitBr { .. }
-        | Fast::DecBr { .. } => if taken { br } else { 7 },
-        Fast::FOp { op: 0..=2, .. } => 11,
-        Fast::FOp { op: 3, .. } => 21,
-        Fast::FOp { .. } => 9,
+        | Fast::DecBr { .. } => if taken { br } else { 21 },
+        Fast::FOp { op: 0..=2, .. } => 33,
+        Fast::FOp { op: 3, .. } => 63,
+        Fast::FOp { .. } => 27,
         // the 64-bit products and multiply-accumulates (`f8 e1` rP = rA * rB, `fc e1` +=, `fe e1` -=)
-        Fast::Raw { raw, .. } if raw & 0xff00 == 0xe100 && matches!(raw & 0xfe, 0xf8 | 0xfc | 0xfe) => 25,
-        _ => if taken { if back { 38 } else { 42 } } else { 5 },
+        Fast::Raw { raw, .. } if raw & 0xff00 == 0xe100 && matches!(raw & 0xfe, 0xf8 | 0xfc | 0xfe) => 75,
+        _ => if taken { if back { 114 } else { 126 } } else { 15 },
     }
 }
 
-/// `op_cost8` for an instruction with no micro-op (`fast_of` None), by its ISA entry's name: the
+/// `op_cost16` for an instruction with no micro-op (`fast_of` None), by its ISA entry's name: the
 /// 2-byte push / pop forms (`[--sp] = {rets, rN-r4}`, `{pc, rN-r4} = [sp++]`: N - 3 registers, and
-/// rets or pc) as the 4-byte masks, a pop into pc a return too; anything else one cycle, or a
-/// taken branch's when it left its fall-through.
-fn named_cost8(name: &str, raw: u64, taken: bool) -> u32 {
+/// rets or pc) as the 4-byte masks, a pop into pc a return too; anything else one 240 MHz cycle
+/// (24 sixteenths of a 360 MHz cycle), or a taken branch's when it left its fall-through.
+fn named_cost16(name: &str, raw: u64, taken: bool) -> u32 {
     let push = name.starts_with("sp_mov_");
     let pop = name.contains("_mov_sp");
     if push || pop {
         let regs = ((raw & 0xf) as u32).saturating_sub(3) + (name.contains("rets") || name.starts_with("pc_")) as u32;
-        return 10 + 8 * regs + if taken { 40 } else { 0 };
+        return 30 + 24 * regs + if taken { 120 } else { 0 };
     }
-    if taken { 42 } else { 8 }
+    if taken { 126 } else { 24 }
 }
 
