@@ -0,0 +1,105 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+"""Verify one accepted original build without pretending it ran dev_validate schema 2.
+
+This is an intentionally exact-candidate adapter. Original source/status/log names
+are preserved; absent original log bytes or unsupported assertions fail closed.
+It authorizes no hardware operation itself and does not issue a release PASS.
+"""
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+
+SCHEMA = 'x0x37.accepted-build-map.v1'
+ACCEPTED = '54f2ffbc3124f7449a69067dc8215a2d91a2e675'
+TREE = '3b5cadafba33f4c1b116660bc9d19a27a892337c'
+BUILT = 'dc4669083218f17f8cfb69069e7f32911a232b52'
+BUILD_TREE = '02cba17c78ab0e0334995f63363c4e8c407ae6a0'
+RECEIPT = 'docs/scheduler-handoffs/first-nightly-fulltree-recovery-20261024.json'
+RECEIPT_SHA = '8b28c21c2a680017c298675d358b7d10575966efcc653337c5cb401da7da4de1'
+UPDATER_SHA = '7e5056036aeae47cf2ce2175de4eef7c255b897349eff8153ef7753c8f775dfa'
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError('accepted-build evidence: '+message)
+
+
+def verify(repo, commit, record, fwsc, ctl):
+    record = Path(record).resolve()
+    data = json.loads(record.read_text())
+    require(data.get('schema') == SCHEMA and data.get('config') == 'dev' and
+            data.get('model') == 'elite' and data.get('controller') is True,
+            'only the exact Elite DEV + controller mapping is supported')
+    require(data.get('accepted_commit') == ACCEPTED and data.get('built_commit') == BUILT,
+            'descriptor source identity mismatch')
+
+    def git(*args):
+        return subprocess.check_output(['git', '-C', str(repo), *args]).strip()
+
+    require(git('rev-parse', commit+'^{commit}').decode() == ACCEPTED and
+            git('rev-parse', ACCEPTED+'^{tree}').decode() == TREE and
+            git('rev-parse', BUILT+'^{tree}').decode() == BUILD_TREE, 'full source identity mismatch')
+    # Same scopes accepted by the upstream independent reviewer; includes build tools
+    # and configuration/pins, rather than only the firmware subtree.
+    scopes = ('firmware', 'tools', 'ble', 'assets', 'build.sh', 'host', 'web')
+    for scope in scopes:
+        require(git('rev-parse', BUILT+':'+scope) == git('rev-parse', ACCEPTED+':'+scope),
+                'compiler input changed: '+scope)
+    raw = subprocess.check_output(['git', '-C', str(repo), 'show', ACCEPTED+':'+RECEIPT])
+    require(digest(raw) == RECEIPT_SHA, 'original build receipt changed')
+    original = json.loads(raw)
+    require(original['source']['commit'] == BUILT and original['source']['tree'] == BUILD_TREE and
+            original['configuration'] == 'DEV X0X_DEV_PADCAL=1' and
+            original['build_status'] == 'BUILD_SUCCEEDED_UNREVIEWED', 'unsupported original build assertions')
+    require(original['budgets'] == {'app_code_free': 5620, 'ram_free': 460,
+            'pool_free': 8324, 'minimum_pool_free': 8192}, 'original build budget mismatch')
+
+    # A map is a locator, not evidence that commands ran. Compare the actual original
+    # bytes to the immutable source receipt; never reconstruct or rename these logs.
+    logs_dir = (record.parent/data['build_logs']).resolve(strict=True)
+    for name in ('elite-build.log', 'pro-build.log', 'controller-build.log'):
+        blob = (logs_dir/name).read_bytes()
+        info = original['logs'][name]
+        require(len(blob) == info['bytes'] and digest(blob) == info['sha256'],
+                'original log missing/changed: '+name)
+
+    review = json.loads((record.parent/data['accepted_review']).read_text())
+    require(review.get('id') == 5638784846 and
+            review.get('commit_id') == '7e89df2b71b2b8e4409cc6a489f4939bbe0b71f7' and
+            review.get('html_url') == 'https://github.com/gobbajogger/X0X37-for-Loopy-Pro/pull/103#pullrequestreview-5638784846' and
+            digest(review.get('body', '').encode()) ==
+            '5cb4a9beb0c8b0e7a668a0e55c652d173794004ea063446fef62432f142c4b9f',
+            'independent accepted-source QA changed/missing')
+    # That review excludes the OLD native CLI. Require the separately reviewed new
+    # updater and its actual independent head-boundary evidence as well.
+    root = Path(__file__).resolve().parents[1]
+    require(digest((root/'tools/fm1_install.py').read_bytes()) == UPDATER_SHA,
+            'native updater differs from independent review')
+    native = root/'review/head-guard-review.json'
+    require(digest(native.read_bytes()) ==
+            '59356c8b8f8c7f3645b2ded3d01b15f7a2e92f0eb4259a39bed61cfce652a79d',
+            'native head-boundary review changed/missing')
+    qa = json.loads(native.read_text())
+    for path, key in [('head-boundary-test.py', 'test_script_sha256'),
+                      ('head-boundary-test.log', 'test_log_sha256'),
+                      ('head-boundary-results.json', 'results_sha256'),
+                      ('head-guard-review.md', 'review_sha256')]:
+        require(digest((native.parent/path).read_bytes()) == qa[key], 'native QA evidence changed: '+path)
+
+    require(ctl is not None, 'matching controller is required')
+    for kind, path in [('elite', fwsc), ('controller', ctl)]:
+        blob = Path(path).read_bytes()
+        info = original['artifacts'][kind]
+        require(len(blob) == info['bytes'] and digest(blob) == info['sha256'], 'artifact differs: '+kind)
+    # Preserve both statuses and identities. This is a verification result, not a new
+    # build, synthetic schema-2 record, full gate PASS, or hardware qualification.
+    return {'schema': SCHEMA, 'result': 'ORIGINAL BUILD MAPPED', 'config': 'dev', 'model': 'elite',
+            'accepted_commit': ACCEPTED, 'accepted_tree': TREE, 'built_commit': BUILT,
+            'original_build_status': original['build_status'], 'original_receipt_sha256': RECEIPT_SHA,
+            'independent_source_review': review['html_url']}
