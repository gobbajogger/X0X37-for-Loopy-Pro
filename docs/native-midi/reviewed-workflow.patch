@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+"""Pinned normal MIDI handoff. Default is offline; --execute is for a fresh hardware thread.
+
+The default descriptor maps the exact original build through a reviewed adapter;
+all original raw logs are mandatory. Missing evidence refuses before MIDI access.
+Never rename the original schema-1 receipt to schema 2 or manufacture DEV CHECKED.
+"""
+import argparse
+import hashlib
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parent
+COMMIT = '54f2ffbc3124f7449a69067dc8215a2d91a2e675'
+TREE = '3b5cadafba33f4c1b116660bc9d19a27a892337c'
+PINS = {
+    'tools/fm1_install.py': '7e5056036aeae47cf2ce2175de4eef7c255b897349eff8153ef7753c8f775dfa',
+    'tools/require_gate_pass.sh': 'cc347a41bdee02f272e7e94db03a37933980515fd36769337efd9046668f8bbf',
+    'tools/dev_validate.py': 'c4ad9f53b697b0999f15d20e9ee08f4b6dfaee4c1d7da8afa6222863f93b5e45',
+    'tools/accepted_build_mapping.py': '172fc656d59bfb5da42abd7e88ee807fee3ddb63ad5790ddfdf95faea5cc9e61',
+    'prep-evidence/accepted-build-map.json': '3d91198d7a0d503100d1ed8e962dfacdf4a1692d24c1b36ac2c2ace837f47aed',
+    'tools/validation_inputs.py': '3341b5f29aa352adecc8b7e6002f9966c8a2fa3c3767640076ab28c937253dc1',
+    'tools/add_ctl.py': 'be5e82b16559ff5483f25fb2e6b20b7862daa4532f38ca799f332727509f34cc',
+    'tools/fm1pkg_make.py': 'd944c138bafb3ac0338eab1f9a1c73ab6eb7f3d75c9a126fb1b2897526ac33dd',
+    'tools/x0x_slots.py': 'af4d1dafafd86398f8e820e5cbd4b10536cf87c489e1022ef706603308b3187c',
+    'inputs/elite-dev.fwsc': 'd14877d6592e6dc158460e960ac5aefd1b2b775588b9f896d3c83f672d61c86c',
+    'inputs/ctl.img': '956e3e214658aeaa06a8c122809399ef3e430c7192291f4d918b7b1181ec2d0a',
+    'inputs/reference-flash.bin': 'fb975d438bc4ab0e7cf05d831d7d254760bd0955c0847870df617a0ef341a650',
+}
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('--dev-record', type=Path, default=ROOT/'prep-evidence/accepted-build-map.json',
+                    help='genuine native validation record or original-build mapping descriptor')
+    ap.add_argument('--execute', action='store_true', help='run the hardware update after all guards pass')
+    args = ap.parse_args()
+    for name, expected in PINS.items():
+        if hashlib.sha256((ROOT/name).read_bytes()).hexdigest() != expected:
+            raise ValueError('pinned input changed: '+name)
+    actual = subprocess.check_output(['git', '-C', str(ROOT), 'rev-parse', COMMIT+'^{tree}'], text=True).strip()
+    if actual != TREE:
+        raise ValueError('accepted Git source tree mismatch')
+    env = dict(os.environ, X0X_REPO=str(ROOT), PYTHONDONTWRITEBYTECODE='1')
+    pkg, ctl, ref = [str(ROOT/'inputs'/p) for p in ('elite-dev.fwsc', 'ctl.img', 'reference-flash.bin')]
+    gate = ['bash', str(ROOT/'tools/require_gate_pass.sh'), COMMIT,
+            '--fwsc', pkg, '--config', 'dev', '--ctl', ctl]
+    record = [] if args.dev_record is None else ['--dev-record', str(args.dev_record.resolve(strict=True))]
+    rc = subprocess.run(gate+record, cwd=ROOT, env=env).returncode
+    if rc:
+        return rc
+    install = ['/usr/bin/python3', '-B', str(ROOT/'tools/fm1_install.py'), pkg]
+    rc = subprocess.run(install+['--head-check', '--head-ref', ref], cwd=ROOT, env=env).returncode
+    if rc or not args.execute:
+        return rc
+    if not sys.stdin.isatty():
+        raise ValueError('--execute requires a foreground terminal in a fresh authorized hardware thread')
+    backup = ROOT/'prep-evidence/elite-slots-before-native-flash.x0xslots'
+    if backup.exists():
+        raise ValueError('fresh backup path already exists; preserve it and resolve before execution')
+    # The updater rechecks gate/head, holds the hardware lock, binds the sole exact-model
+    # target, takes the fresh backup, stages, writes, reboots and checks sample/controller readback.
+    return subprocess.run(install+['--port', 'X0X FM-1', '--ctl', ctl, '--commit', COMMIT,
+        '--config', 'dev', '--head-ref', ref, '--backup', str(backup), '--yes']+record,
+        cwd=ROOT, env=env).returncode
+
+
+if __name__ == '__main__':
+    try:
+        sys.exit(main())
+    except (OSError, ValueError, subprocess.SubprocessError) as error:
+        print('REFUSED: '+str(error), file=sys.stderr)
+        sys.exit(3)
