{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LoopyX0X37 scheduler Git handoff (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_utc",
    "role",
    "outcome",
    "source",
    "summary",
    "outputs",
    "checks",
    "next"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_utc": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "role": {
      "type": "string",
      "minLength": 3
    },
    "outcome": {
      "enum": [
        "DELIVERED",
        "REVIEW_DELIVERED",
        "NO_NEW_DELIVERABLE",
        "DELIVERY_BLOCKED"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "tested_commit",
        "tested_tree"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "tested_commit": {
          "$ref": "#/$defs/gitSha"
        },
        "tested_tree": {
          "$ref": "#/$defs/gitSha"
        },
        "pr": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "location",
          "description"
        ],
        "properties": {
          "kind": {
            "enum": [
              "source",
              "regression",
              "benchmark",
              "findings",
              "build-manifest",
              "site-preview",
              "review",
              "integration",
              "catalog",
              "publication"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "command",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "BLOCKED"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 2
          },
          "exit_code": {
            "type": "integer"
          },
          "evidence": {
            "type": "string",
            "minLength": 5
          },
          "log_sha256": {
            "$ref": "#/$defs/hash256"
          },
          "coverage": {
            "type": "string"
          }
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "build_status",
          "device_status"
        ],
        "properties": {
          "model": {
            "enum": [
              "elite",
              "pro"
            ]
          },
          "build_status": {
            "enum": [
              "NOT_RUN",
              "BLOCKED",
              "FAILED",
              "BUILT",
              "CHECKED"
            ]
          },
          "device_status": {
            "enum": [
              "DEVICE_NOT_TESTED",
              "DEVICE_VERIFIED"
            ]
          },
          "config": {
            "type": "string"
          },
          "artifact": {
            "type": "string"
          },
          "artifact_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "artifact_sha256": {
            "$ref": "#/$defs/hash256"
          },
          "controller_sha256": {
            "$ref": "#/$defs/hash256"
          },
          "package_crc32": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{8}$"
          },
          "flash_headroom_bytes": {
            "type": "integer"
          },
          "ram_headroom_bytes": {
            "type": "integer"
          },
          "pool_headroom_bytes": {
            "type": "integer"
          },
          "notes": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "build_status": {
                  "enum": [
                    "BUILT",
                    "CHECKED"
                  ]
                }
              },
              "required": [
                "build_status"
              ]
            },
            "then": {
              "required": [
                "config",
                "artifact",
                "artifact_bytes",
                "artifact_sha256",
                "controller_sha256"
              ]
            }
          }
        ]
      }
    },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "action",
        "gate"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 2
        },
        "action": {
          "type": "string",
          "minLength": 8
        },
        "gate": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "publication": {
      "enum": [
        "NOT_APPLICABLE",
        "SOURCE_ONLY",
        "GIT_PAGES_ONLY",
        "HTTP_VERIFIED",
        "NOT_PUBLISHED"
      ]
    }
  },
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "hash256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "DELIVERED",
              "REVIEW_DELIVERED"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "outputs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "properties": {
        "checks": {
          "items": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "PASS"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "exit_code"
                  ],
                  "properties": {
                    "exit_code": {
                      "const": 0
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "FAIL"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "exit_code"
                  ]
                }
              }
            ]
          }
        }
      }
    }
  ]
}
