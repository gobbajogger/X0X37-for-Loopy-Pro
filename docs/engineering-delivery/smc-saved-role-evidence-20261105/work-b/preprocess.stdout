typedef struct { int set; int sound; } project_t;
static project_t proj;
static uint8_t project_incompatible, settings_read_failed, settings_load_failed;
static uint32_t packed_len;
static int layout_valid, measure_rc, set_rc, sound_rc, stream_rc;
static unsigned layout_calls, capture_calls, measure_calls, save_calls, stream_calls;
static unsigned failures, checks, cases;
static int stream_layout_ok(const project_t *p, uint32_t format) {
    ++layout_calls;
    do { ++checks; if (!(p == &proj && format == 13u)) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 30, "p == &proj && format == PROJ_STREAM"); } } while (0);
    return layout_valid;
}
static void capture_settings(int *p) {
    ++capture_calls; do { ++checks; if (!(p == &proj.set)) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 34, "p == &proj.set"); } } while (0); *p=17;
}
static int measure_project(const project_t *p, uint32_t *len) {
    ++measure_calls; do { ++checks; if (!(p == &proj && len == &packed_len)) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 37, "p == &proj && len == &packed_len"); } } while (0);
    *len=99; return measure_rc;
}
static int save_obj(unsigned obj, const void *p, size_t n) {
    ++save_calls;
    do { ++checks; if (!((obj == 0 && p == &proj.set && n == sizeof proj.set && save_calls == 1) || (obj == 1 && p == &proj.sound && n == sizeof proj.sound && save_calls == 2))) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 42, "(obj == OBJ_SET && p == &proj.set && n == sizeof proj.set && save_calls == 1) || (obj == OBJ_SOUND && p == &proj.sound && n == sizeof proj.sound && save_calls == 2)"); } } while (0);
    return obj == 0 ? set_rc : sound_rc;
}
static int save_stream(void) { ++stream_calls; return stream_rc; }
int project_save(void)
{
    if (project_incompatible || !stream_layout_ok(&proj, 13u))
        return -9;
    if (settings_read_failed || settings_load_failed) return -8;
    capture_settings(&proj.set);
    if (measure_project(&proj, &packed_len))
        return -7;
    if (save_obj(0, &proj.set, sizeof proj.set))
        return -1;
    if (save_obj(1, &proj.sound, sizeof proj.sound))
        return -2;
    return save_stream();
}
static void reset(unsigned incompatible, int valid, unsigned read_fence, unsigned load_fence) {
    memset(&proj, 0, sizeof proj);
    project_incompatible=(uint8_t)incompatible;
    settings_read_failed=(uint8_t)read_fence;
    settings_load_failed=(uint8_t)load_fence;
    layout_valid=valid;
    measure_rc=set_rc=sound_rc=stream_rc=0;
    layout_calls=capture_calls=measure_calls=save_calls=stream_calls=0;
    packed_len=123;
}
int main(void) {
    puts("CONFIG X0X_HOST=1 X0X_BASS_TAGGED_SOUND=0 X0X_BASS_PRESET_PREVIEW=0");
    puts("SCOPE actual_project_save_control_flow_with_stubs; device/engine branches NOT_RUN");
    for (unsigned incompatible=0; incompatible<=2; ++incompatible)
        for (int valid=0; valid<=1; ++valid)
            for (unsigned read_fence=0; read_fence<=1; ++read_fence)
                for (unsigned load_fence=0; load_fence<=1; ++load_fence) {
                    reset(incompatible, valid, read_fence, load_fence);
                    int expected=(incompatible || !valid) ? -9 :
                                 (read_fence || load_fence) ? -8 : 0;
                    int rc=project_save();
                    ++cases;
                    printf("CASE incompatible=%u valid=%d read=%u load=%u expected=%d actual=%d layout=%u capture=%u measure=%u save=%u stream=%u\n",
                           incompatible, valid, read_fence, load_fence, expected, rc,
                           layout_calls, capture_calls, measure_calls, save_calls, stream_calls);
                    do { ++checks; if (!(rc == expected)) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 98, "rc == expected"); } } while (0);
                    do { ++checks; if (!(layout_calls == (incompatible ? 0u : 1u))) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 99, "layout_calls == (incompatible ? 0u : 1u)"); } } while (0);
                    if (expected) {
                        do { ++checks; if (!(capture_calls == 0)) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 101, "capture_calls == 0"); } } while (0);
                        do { ++checks; if (!(measure_calls == 0)) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 102, "measure_calls == 0"); } } while (0);
                        do { ++checks; if (!(save_calls == 0)) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 103, "save_calls == 0"); } } while (0);
                        do { ++checks; if (!(stream_calls == 0)) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 104, "stream_calls == 0"); } } while (0);
                        do { ++checks; if (!(packed_len == 123 && proj.set == 0)) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 105, "packed_len == 123 && proj.set == 0"); } } while (0);
                    } else {
                        do { ++checks; if (!(capture_calls == 1)) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 107, "capture_calls == 1"); } } while (0);
                        do { ++checks; if (!(measure_calls == 1)) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 108, "measure_calls == 1"); } } while (0);
                        do { ++checks; if (!(save_calls == 2)) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 109, "save_calls == 2"); } } while (0);
                        do { ++checks; if (!(stream_calls == 1)) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 110, "stream_calls == 1"); } } while (0);
                        do { ++checks; if (!(packed_len == 99 && proj.set == 17)) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 111, "packed_len == 99 && proj.set == 17"); } } while (0);
                    }
                }
    reset(0,1,0,0); measure_rc=1;
    do { ++checks; if (!(project_save() == -7)) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 117, "project_save() == -7"); } } while (0);
    do { ++checks; if (!(capture_calls == 1 && measure_calls == 1 && save_calls == 0 && stream_calls == 0)) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 118, "capture_calls == 1 && measure_calls == 1 && save_calls == 0 && stream_calls == 0"); } } while (0);
    reset(0,1,0,0); set_rc=1;
    do { ++checks; if (!(project_save() == -1)) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 120, "project_save() == -1"); } } while (0);
    do { ++checks; if (!(capture_calls == 1 && measure_calls == 1 && save_calls == 1 && stream_calls == 0)) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 121, "capture_calls == 1 && measure_calls == 1 && save_calls == 1 && stream_calls == 0"); } } while (0);
    reset(0,1,0,0); sound_rc=1;
    do { ++checks; if (!(project_save() == -2)) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 123, "project_save() == -2"); } } while (0);
    do { ++checks; if (!(capture_calls == 1 && measure_calls == 1 && save_calls == 2 && stream_calls == 0)) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 124, "capture_calls == 1 && measure_calls == 1 && save_calls == 2 && stream_calls == 0"); } } while (0);
    reset(0,1,0,0); stream_rc=7;
    do { ++checks; if (!(project_save() == 7)) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 126, "project_save() == 7"); } } while (0);
    do { ++checks; if (!(capture_calls == 1 && measure_calls == 1 && save_calls == 2 && stream_calls == 1)) { ++failures; fprintf(stderr, "FAIL line=%d: %s\n", 127, "capture_calls == 1 && measure_calls == 1 && save_calls == 2 && stream_calls == 1"); } } while (0);
    printf("cases=%u checks=%u failures=%u result=%s\n", cases, checks, failures, failures ? "FAIL" : "PASS");
    return failures ? 1 : 0;
}
