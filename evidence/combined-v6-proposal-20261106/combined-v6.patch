+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-only
+set -eu
+cd "$(dirname "$0")/../.."
+OUT=$(mktemp -d "${TMPDIR:-/tmp}/x0x-ble-peer-name-bounds.XXXXXX")
+trap 'rm -rf "$OUT"' EXIT HUP INT TERM
