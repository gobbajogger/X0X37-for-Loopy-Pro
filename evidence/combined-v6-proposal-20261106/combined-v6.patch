+static unsigned eng_prof_frames, eng_scope_w;
+static int16_t eng_scope[512];
+static uint16_t eng_peak[5];
+static float part_peak[5], out_lim = 1.0f, out_scale = 4194304.0f;
+static int mot, mst, fx;
