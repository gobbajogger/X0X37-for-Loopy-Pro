@@ -0,0 +1,67 @@
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "../../firmware/src/app/lcd_tiles.h"
+
+#define W 240u
+#define MAX_ROWS 138u
+#define OLD_COLS (W/8u)
+#define NEW_ROWS ((MAX_ROWS+X0X_LCD_TILE_H-1u)/X0X_LCD_TILE_H)
