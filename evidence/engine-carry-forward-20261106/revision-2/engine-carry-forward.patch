+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-only
+# Compile the same voice as the production cache and a separate uncached
+# reference; real oscillator, filter, FMA and gain paths are shared.
+set -eu
+cd "$(dirname "$0")/../.."
+CC=${CC:-cc}
+OUT=${X0X_CHICAGO_COEF_CACHE_OUT:-build/host/chicago-coef-cache}
+mkdir -p "$OUT"
+CFLAGS="-O2 -std=c99 -fno-fast-math -ffp-contract=off -ffunction-sections -fdata-sections -DORIGINAL_USE_SOFT_FMA -Iexperiments/original_synth -Iexperiments/wobble -Ifirmware/src -Ifirmware/src/dsp"
+case "$(uname -s)" in
+ Darwin) GC="-Wl,-dead_strip" ;;
+ *) GC="-Wl,--gc-sections" ;;
+esac
+set --
+for name in $(grep -oE 'original_chicago_voice_[a-z0-9_]+[(]' experiments/original_synth/chicago_voice.c | sed 's/($//' | sort -u); do
+ case "$name" in original_chicago_voice_kernel|original_chicago_voice_span) continue ;; esac
+ set -- "$@" "-D${name}=uncached_${name}"
+done
+$CC $CFLAGS -DCHICAGO_COEF_CACHE_REFERENCE "$@" -c experiments/original_synth/chicago_voice.c -o "$OUT/uncached_voice.o"
+$CC $CFLAGS \
+ tests/host/chicago_coef_cache_test.c \
+ experiments/original_synth/chicago_voice.c \
+ experiments/original_synth/chicago_program.c \
+ experiments/original_synth/chicago_mp4.c \
+ experiments/original_synth/chicago_voice_snapshot.c \
+ experiments/original_synth/state_codec.c \
+ experiments/original_synth/control_math.c \
+ experiments/original_synth/miami_ms20.c \
+ experiments/original_synth/oscillator_motion.c \
+ experiments/original_synth/voice_gain.c \
+ experiments/original_synth/fused_reference.c \
+ experiments/wobble/miami_fx_conversion.c \
+ "$OUT/uncached_voice.o" $GC -lm -o "$OUT/test"
+"$OUT/test"
diff --git a/tests/host/chicago_packed_cache_test.c b/tests/host/chicago_packed_cache_test.c
new file mode 100644
index 00000000..07021551
--- /dev/null
+++ b/tests/host/chicago_packed_cache_test.c
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "chicago_packed.h"
+#include "chicago_packed_private.h"
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+#include <stdlib.h>
+static unsigned checks;
+#define CHECK(x) do { ++checks; if (!(x)) { fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#x); exit(1); } } while(0)
+static uint32_t bits(float f){uint32_t u;memcpy(&u,&f,4);return u;}
+static void rejected(uint32_t index){
+ float a=1.25f,e=-2.5f;
+ CHECK(!original_chicago_packed_lookup(NULL,index,&a,&e));
+ CHECK(bits(a)==bits(1.25f)&&bits(e)==bits(-2.5f));
+}
+int main(void){
+ /* Must be the first lookup: UINT32_MAX was also the cold cache sentinel. */
+ rejected(UINT32_MAX);
+ uint32_t count=original_chicago_packed_a.count;
+ CHECK(count==original_chicago_packed_e.count);
+ for(uint32_t i=0;i<count;i++){
+  uint32_t ab,eb;float a,e;
+  CHECK(original_lossless_second16_lookup(&original_chicago_packed_a,i,&ab));
+  CHECK(original_lossless_second16_lookup(&original_chicago_packed_e,i,&eb));
+  for(unsigned repeat=0;repeat<2;repeat++){
+   CHECK(original_chicago_packed_lookup(NULL,i,&a,&e));
+   CHECK(bits(a)==ab&&bits(e)==eb);
+  }
+ }
+ rejected(count);rejected(count+1);rejected(UINT32_MAX);
+ float a=1.25f,e=-2.5f;
+ CHECK(!original_chicago_packed_lookup(&a,0,&a,&e));
+ CHECK(!original_chicago_packed_lookup(NULL,0,NULL,&e));
+ CHECK(!original_chicago_packed_lookup(NULL,0,&a,NULL));
+ CHECK(!original_chicago_packed_lookup(NULL,0,&a,&a));
+ CHECK(bits(a)==bits(1.25f)&&bits(e)==bits(-2.5f));
+ printf("PASS Chicago packed cache: %u checks, %u entries, cold/warm invalid indices preserve outputs\n",checks,count);
+ return 0;
+}
