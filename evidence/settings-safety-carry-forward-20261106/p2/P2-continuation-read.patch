diff --git a/tests/host/project_stage_test.c b/tests/host/project_stage_test.c
index 9cc79ec2..c21b5039 100644
--- a/tests/host/project_stage_test.c
+++ b/tests/host/project_stage_test.c
@@ -748,6 +748,30 @@ static void test_interobject_power_cut(void)
     proj.pat[0].bass[0].step[0] = (bstep_t){48, G_NOTE, 110};
     REQUIRE(project_save() == 0);
     REQUIRE(packed_len > 3u * (PLAT_STORE_MAX - 4u) - (STREAM_HDR - 4u));
+    /* Continuation I/O failure is retryable, never proof of damaged data.
+     * Exercise every occupied continuation at header and payload boundaries. */
+    for (unsigned k = 1; k < NSTREAM; ++k) {
+        for (unsigned payload = 0; payload < 2; ++payload) {
+            st_hdr_t h;
+            int copy = st_current(STREAM_OBJ[k], &h);
+            REQUIRE(copy >= 0);
+            memcpy(&saved_project, &proj, sizeof proj);
+            snapshot();
+            settings_read_failure = (int)(st_sector(STREAM_OBJ[k], (unsigned)copy) +
+                (payload ? ST_PAYLOAD_OFF : 0u));
+            CHECK(project_load() < 0);
+            CHECK(project_storage_unsupported() == 0);
+            CHECK(project_save() == -8);
+            check_no_writes();
+            settings_read_failure = -1;
+            CHECK(project_load_stage() == 0);
+            CHECK(project_save() == -8); /* staging is not live adoption */
+            check_no_writes();
+            CHECK(project_load() == 0);
+            CHECK(!memcmp(&proj, &saved_project, sizeof proj));
+            CHECK(project_save() == 0);
+        }
+    }
     /* Leave genuinely different A/B history; recovery must choose per object,
      * rather than blindly taking the older copy of every object. */
     proj.pat[0].bass[0].step[0] = (bstep_t){60, G_NOTE, 100};
