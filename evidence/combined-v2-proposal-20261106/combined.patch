diff --git a/tests/host/drum909_tanh_pair_test.c b/tests/host/drum909_tanh_pair_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..3b2d17a0defbf8f6c94e9e619ce811f3f5fa5935
--- /dev/null
+++ b/tests/host/drum909_tanh_pair_test.c
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* d9_tanh_pair against x0x_tanh_value: every table index, and d9_tanh against
+ * the two-lookup body for every non-NaN binary32 input (bit for bit). */
+#define X0X_DRUM_TABLES_DEFINE
+#include "drum909_dsp.h"
+#include <stdio.h>
+#include <string.h>
+
+static float ref_tanh(float u)
+{
+    const float a = fm_fabsf(u) * X0X_TANH_SCALE;
+    float t;
+    if (a >= (float)X0X_TANH_N) {
+        t = 1.0f;
+    } else {
+        const int32_t i = (int32_t)a;
+        const float fr = a - (float)i;
+        const float t0 = x0x_tanh_value((unsigned)i);
+        const float t1 = x0x_tanh_value((unsigned)i + 1u);
+        t = t0 + (t1 - t0) * fr;
+    }
+    return u < 0.0f ? -t : t;
+}
+
+static uint32_t bits(float f) { uint32_t u; memcpy(&u, &f, sizeof u); return u; }
+
+int main(void)
+{
+    /* every index; and the 8-byte read of the packed path stays inside the words */
+    for (unsigned i = 0; i < X0X_TANH_N; ++i) {
+        float a, b;
+        d9_tanh_pair(i, &a, &b);
+        if (bits(a) != bits(x0x_tanh_value(i)) || bits(b) != bits(x0x_tanh_value(i + 1u))) {
+            fprintf(stderr, "pair mismatch at %u\n", i);
+            return 1;
+        }
+        unsigned r = 0, start = 0;
+        while (i >= x0x_tanh_run_end[r]) { start = x0x_tanh_run_end[r]; ++r; }
+        const x0x_tanh_run_t *run = &x0x_tanh_runs[r];
+        if (i + 1u < x0x_tanh_run_end[r] && run->width && 2u * run->width <= 57u) {
+            const unsigned byte = run->offset * 4u + (i - start) * run->width / 8u;
+            if (byte + 8u > sizeof x0x_tanh_words) {
+                fprintf(stderr, "read past the words at %u\n", i);
+                return 1;
+            }
+        }
+    }
+    unsigned long long n = 0;
+    uint32_t u = 0;
+    do {
+        float x;
+        memcpy(&x, &u, sizeof x);
+        if (x == x) {
+            if (bits(d9_tanh(x)) != bits(ref_tanh(x))) {
+                fprintf(stderr, "d9_tanh mismatch at 0x%08x\n", u);
+                return 1;
+            }
+            ++n;
+        }
+    } while (++u != 0);
+    printf("PASS: %u indices, %llu non-NaN binary32 inputs bit-identical\n", (unsigned)X0X_TANH_N, n);
+    return 0;
+}
diff --git a/tests/host/gen_arc8_table.c b/tests/host/gen_arc8_table.c
new file mode 100644
index 0000000000000000000000000000000000000000..57a2111eb83226156f7c2468c61bbbdb3792a7a9
--- /dev/null
+++ b/tests/host/gen_arc8_table.c
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Regenerate with gcc -O1 -ffp-contract=off -Ifirmware/src tests/host/gen_arc8_table.c. */
+#include <stdio.h>
+#include <stdint.h>
+#include <string.h>
+#include "dsp/fastmath.h"
+static float turns(float y, float x)
+{
+    float ax = fm_fabsf(x), ay = fm_fabsf(y), a = ax < ay ? ax / (ay + 1e-9f) : ay / (ax + 1e-9f), s = a * a, r;
+    r = ((-0.0464964749f * s + 0.15931422f) * s - 0.327622764f) * s * a + a;   /* atan on [0, 1] */
+    if (ay > ax)
+        r = 1.57079637f - r;
+    if (x < 0.0f)
+        r = FM_PI - r;
+    if (y < 0.0f)
+        r = FM_TWO_PI - r;
+    return r * (1.0f / FM_TWO_PI);
+}
+
+int main(void)
+{
+    puts("/* SPDX-License-Identifier: GPL-3.0-only */");
+    puts("/* Generated by tests/host/gen_arc8_table.c with the original float arithmetic. */");
+    puts("static const struct { int8_t x, y; uint8_t coverage; uint32_t turns_bits; } arc8_geometry[] = {");
+    for (int y = -9; y <= 9; ++y) for (int x = -9; x <= 9; ++x) {
+        float dx = (float)x + 0.5f - 0.5f, dy = (float)y + 0.5f - 0.5f;
+        float d = fm_sqrtf(dx * dx + dy * dy), t;
+        float a = fm_clampf(8.0f + 0.5f - d, 0.0f, 1.0f) * fm_clampf(d - (8.0f - 3.4f) + 0.5f, 0.0f, 1.0f);
+        if (a <= 0.0f) continue;
+        t = turns(dy, dx) - 0.375f;
+        if (t < 0.0f) t += 1.0f;
+        t /= 0.75f;
+        if (t > 1.0f) continue;
+        uint32_t bits; memcpy(&bits, &t, sizeof bits);
+        printf("    {%d, %d, %u, 0x%08xu},\n", x, y, (unsigned)(a * 16.0f + 0.5f), (unsigned)bits);
+    }
+    puts("};");
+    return 0;
+}
