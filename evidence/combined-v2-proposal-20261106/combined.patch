+int main(void)
+{
+    for (int part = PART_909; part <= PART_303B; ++part)
+        for (int bank = 0; bank < 4; ++bank) carried_step(part, bank);
+    printf("held-step-release: PASS (%u checks, both kits/voices, all four step banks)\n", checks);
